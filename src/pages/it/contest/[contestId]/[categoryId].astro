---
import ContestCategoryPage from '@/components/pages/ContestCategoryPage.astro';
import { getLocalizedPath } from '@/i18n';

const { contestId, categoryId } = Astro.params;

if (!contestId || !categoryId) {
  return Astro.redirect(getLocalizedPath('404', 'it'));
}
---

<ContestCategoryPage lang="it" contestId={contestId} categoryId={categoryId} />
