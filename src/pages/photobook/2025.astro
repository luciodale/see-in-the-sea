      }
      .pb-triptych--left .pb-triptych__figure {
        grid-column: 1 / span 8;
      }
      .pb-triptych--left .pb-triptych__text {
        grid-column: 9 / span 4;
      }
      .pb-triptych--right .pb-triptych__figure {
        grid-column: 5 / span 8;
        order: 2;
      }
      .pb-triptych--right .pb-triptych__text {
        grid-column: 1 / span 4;
        order: 1;
      }
      .pb-triptych__figure {
        margin: 0;
      }
      .pb-triptych__figure img {
