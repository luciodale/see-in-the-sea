        justify-content: center;
        gap: 0;
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.72);
      }
      /* 2. Intro */
      .pb-intro {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 160px 40px 120px;
      }
      .pb-intro__inner {
        max-width: 820px;
        text-align: center;
      }
      .pb-intro__title {
        font-family: var(--pb-serif);
        font-size: clamp(40px, 5.2vw, 80px);
        line-height: 1.02;
        letter-spacing: -0.01em;
        margin: 0 0 40px;
        color: var(--pb-fg);
      }
      .pb-intro__title em {
        font-style: italic;
        color: var(--pb-muted);
      }
      .pb-intro__body p {
        font-family: var(--pb-sans);
        font-weight: 300;
        font-size: clamp(15px, 1.1vw, 18px);
        line-height: 1.85;
        letter-spacing: 0.005em;
        color: rgba(244, 242, 238, 0.86);
        margin: 0 0 18px;
      }
      .pb-toc {
        list-style: none;
        margin: 64px 0 0;
        padding: 32px 0 0;
        border-top: 1px solid var(--pb-line);
