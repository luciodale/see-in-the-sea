        margin: 0 0 18px;
      }
      .pb-toc {
        list-style: none;
        margin: 64px 0 0;
        padding: 32px 0 0;
        border-top: 1px solid var(--pb-line);
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px 32px;
        text-align: left;
      }
      .pb-toc li {
        font-family: var(--pb-sans);
        font-size: 12px;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--pb-fg);
        display: flex;
        gap: 14px;
      }
      .pb-toc li span {
        font-family: var(--pb-serif);
        font-style: italic;
        font-size: 14px;
        color: var(--pb-muted);
        text-transform: none;
        letter-spacing: 0;
      }

      /* 2b. People (leadership + judges) */
      .pb-people {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 160px 40px 120px;
      }
      .pb-people__inner {
        max-width: 1120px;
        width: 100%;
        text-align: center;
      }
      .pb-people__title {
        font-family: var(--pb-serif);
        font-size: clamp(36px, 4.4vw, 68px);
        line-height: 1.02;
        letter-spacing: -0.01em;
        margin: 14px 0 64px;
        color: var(--pb-fg);
      }
      .pb-people__title em {
        font-style: italic;
        color: var(--pb-muted);
      }
      .pb-people__grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 56px 64px;
        text-align: left;
        padding-top: 40px;
        border-top: 1px solid var(--pb-line);
      }
      .pb-people__grid--three {
        grid-template-columns: repeat(3, 1fr);
        gap: 48px 48px;
      }
      .pb-person {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }
      .pb-person__role {
        font-family: var(--pb-sans);
        font-weight: 400;
        font-size: 11px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--pb-muted);
        margin: 0;
      }
      .pb-person__name {
        font-family: var(--pb-serif);
        font-size: clamp(26px, 2.6vw, 40px);
        line-height: 1.1;
        letter-spacing: -0.01em;
        color: var(--pb-fg);
        margin: 0;
      }
      .pb-person__name em {
        font-style: italic;
      }
      .pb-person__body {
        font-family: var(--pb-sans);
        font-weight: 300;
        font-size: clamp(14px, 1vw, 16px);
        line-height: 1.8;
        letter-spacing: 0.005em;
        color: rgba(244, 242, 238, 0.82);
        margin: 0;
      }
      .pb-people__grid--portraits {
        text-align: center;
      }
      .pb-person--portrait {
        align-items: center;
        gap: 20px;
      }
      .pb-person__portrait {
        margin: 0;
        width: 100%;
        max-width: 260px;
        aspect-ratio: 4 / 5;
        overflow: hidden;
        border-radius: 2px;
        background: #1a1a1a;
      }
      .pb-person__portrait img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        filter: grayscale(1) contrast(1.02);
      }
      .pb-person--portrait .pb-person__name {
        text-align: center;
      }

      /* 3. Dividers — single tight layout, applied to all */
      .pb-divider {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        column-gap: 6vw;
        padding: 140px 80px 80px;
        position: relative;
        overflow: hidden;
      }
      .pb-divider--num-left .pb-divider__index {
        grid-column: 1;
        justify-self: end;
        text-align: right;
      }
      .pb-divider--num-left .pb-divider__label {
        grid-column: 2;
        justify-self: start;
        text-align: left;
      }
      .pb-divider__index {
        font-family: var(--pb-serif);
        font-style: italic;
        font-size: clamp(180px, 22vw, 340px);
        line-height: 0.82;
        letter-spacing: -0.03em;
        color: #fff;
        opacity: 1;
      }
      .pb-divider__label h2 {
        font-family: var(--pb-serif);
        font-size: clamp(56px, 6.4vw, 112px);
        line-height: 0.98;
        letter-spacing: -0.02em;
        margin: 18px 0 28px;
        color: #fff;
      }
      .pb-divider__label h2 em {
        font-style: italic;
        color: #fff;
      }
      .pb-divider__label p {
        font-family: var(--pb-sans);
        font-weight: 300;
        font-size: clamp(14px, 1.05vw, 17px);
        line-height: 1.6;
        color: var(--pb-muted);
        max-width: 36ch;
        margin: 0;
      }

      /* 4,12. Full-bleed features */
      .pb-feature--bleed {
        position: relative;
        overflow: hidden;
      }
      .pb-bleed__figure {
        position: relative;
        width: 100%;
        height: 100vh;
        min-height: 640px;
        margin: 0;
        overflow: hidden;
      }
      .pb-bleed__figure img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      .pb-bleed__figure--natural {
        height: auto;
        min-height: 0;
      }
      .pb-bleed__figure--natural img {
        width: 100%;
        height: auto;
        object-fit: initial;
      }
      .pb-editorial {
        padding: 120px 40px 160px;
        max-width: 100%;
      }
      .pb-editorial--floated {
        max-width: 640px;
        margin-left: 10vw;
        padding-top: 56px;
      }
      .pb-editorial--centered {
        max-width: 640px;
        margin: 0 auto;
        text-align: center;
      }
      .pb-editorial--centered .pb-author {
        justify-content: center;
      }
      .pb-editorial--centered .pb-body-text {
        margin: 0 auto;
      }
      .pb-editorial h3,
      .pb-feature h3,
      .pb-portfolio h3 {
        font-family: var(--pb-serif);
        font-size: clamp(40px, 5.4vw, 88px);
        line-height: 1;
        letter-spacing: -0.015em;
        margin: 0 0 6px;
        color: var(--pb-fg);
      }
      .pb-editorial h3 em {
        font-style: italic;
      }

      /* 5. Plate */
      .pb-feature--plate {
        padding: 140px 0 160px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .pb-plate {
        width: 100%;
        text-align: center;
      }
      .pb-plate .pb-eyebrow {
        padding: 0 40px;
      }
      .pb-plate__figure {
        margin: 0 auto 56px;
        width: 100%;
        max-width: 1080px;
        padding: 0 40px;
      }
      .pb-plate__figure img {
        width: 100%;
        height: auto;
      }
      .pb-plate__text {
        max-width: 680px;
        margin: 0 auto;
        padding: 0 40px;
      }
      .pb-plate__text .pb-author {
        justify-content: center;
      }
      .pb-plate__text .pb-body-text {
        margin: 0 auto;
      }

      /* 6,9. Split */
      .pb-feature--split {
        display: grid;
        min-height: 100vh;
        align-items: stretch;
      }
      .pb-split--right {
        grid-template-columns: 1fr 1.15fr;
      }
      .pb-split--left {
        grid-template-columns: 1.15fr 1fr;
      }
      .pb-split__figure {
        position: relative;
        overflow: hidden;
        min-height: 80vh;
      }
      .pb-split__figure img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      .pb-split__figure--bleed {
        margin-left: -20px;
      }
      .pb-split__text {
        padding: 140px 72px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        max-width: 620px;
      }
      .pb-split__text--narrow {
        max-width: 520px;
      }

      /* 8. Stacked */
      .pb-feature--stacked {
        padding: 160px 40px 160px;
      }
      .pb-stacked__head {
        text-align: center;
        max-width: 840px;
        margin: 0 auto 72px;
      }
      .pb-stacked__head .pb-author {
        justify-content: center;
      }
      .pb-stacked__title {
        font-size: clamp(56px, 8vw, 140px) !important;
      }
      .pb-stacked__figure {
        margin: 0 auto;
        max-width: 1000px;
      }
      .pb-stacked__figure img {
        width: 100%;
      }
      .pb-stacked__body {
        max-width: 620px;
        margin: 72px auto 0;
        text-align: center;
      }

      /* 10. Quote */
      .pb-feature--quote {
        padding: 160px 40px 140px;
        display: grid;
        grid-template-columns: 1fr 1.1fr;
        grid-template-rows: auto 1fr;
        gap: 48px 64px;
        max-width: 1500px;
        margin: 0 auto;
        align-items: center;
      }
      .pb-quote {
        margin: 0;
        grid-column: 1;
        grid-row: 1;
        align-self: end;
      }
      .pb-quote p {
        font-family: var(--pb-serif);
        font-size: clamp(36px, 4.4vw, 72px);
        line-height: 1.04;
        letter-spacing: -0.01em;
        margin: 0 0 24px;
      }
      .pb-quote p em {
        font-style: italic;
        color: var(--pb-muted);
      }
      .pb-quote footer {
        font-family: var(--pb-sans);
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--pb-muted);
        display: inline-flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
      }
      .pb-quote__figure {
        grid-column: 2;
        grid-row: 1 / span 2;
        margin: 0;
        align-self: stretch;
      }
      .pb-quote__figure img {
        width: 100%;
        height: 100%;
        min-height: 65vh;
        object-fit: contain;
      }
      .pb-quote__body {
        grid-column: 1;
        grid-row: 2;
        align-self: start;
      }

      /* 13. Offset */
      .pb-feature--offset {
        padding: 160px 40px 160px;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 40px;
        min-height: 100vh;
        align-items: center;
      }
      .pb-offset__figure {
        grid-column: 2 / span 7;
        margin: 0;
      }
      .pb-offset__figure img {
        width: 100%;
      }
      .pb-offset__text {
        grid-column: 9 / span 4;
        margin-top: 120px;
        max-width: 320px;
      }

      /* 14. Aside */
      .pb-feature--aside {
        padding: 140px 40px 140px;
        display: grid;
        grid-template-columns: 1fr 1.15fr;
        gap: 72px;
        max-width: 1500px;
        margin: 0 auto;
        align-items: center;
      }
      .pb-aside__title {
        font-size: clamp(48px, 6vw, 108px) !important;
      }
      .pb-aside__figure {
        margin: 0;
      }
      .pb-aside__figure img {
        width: 100%;
        height: auto;
        max-height: 70vh;
        object-fit: contain;
      }

      /* 16,18. Portfolio triptych alternating + zigzag */
      .pb-portfolio {
        padding: 140px 40px 140px;
      }
      .pb-portfolio__head {
        text-align: center;
        margin: 0 auto 96px;
      }
      .pb-portfolio__name {
        font-size: clamp(56px, 7.4vw, 128px) !important;
      }
      .pb-triptych {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 64px;
        align-items: center;
        margin: 0 0 140px;
      }
      .pb-triptych:last-child {
        margin-bottom: 0;
      }
      .pb-triptych--left .pb-triptych__figure {
        grid-column: 1 / span 8;
      }
      .pb-triptych--left .pb-triptych__text {
        grid-column: 9 / span 4;
      }
      .pb-triptych--right .pb-triptych__figure {
        grid-column: 5 / span 8;
        order: 2;
      }
      .pb-triptych--right .pb-triptych__text {
        grid-column: 1 / span 4;
        order: 1;
      }
      .pb-triptych__figure {
        margin: 0;
      }
      .pb-triptych__figure img {
        width: 100%;
      }
      .pb-triptych__text h4 {
        font-family: var(--pb-serif);
        font-size: clamp(32px, 3.4vw, 54px);
        line-height: 1.02;
        letter-spacing: -0.01em;
        margin: 0 0 2px;
      }
      .pb-triptych__num {
        font-family: var(--pb-serif);
        font-style: italic;
        font-size: 14px;
        color: var(--pb-muted);
        display: block;
        margin-bottom: 12px;
      }

      /* 17. Grid-three */
      .pb-portfolio--grid .pb-grid-three {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
        margin: 0 0 100px;
      }
      .pb-grid-three__item {
        margin: 0;
      }
      .pb-grid-three__item img {
        width: 100%;
        aspect-ratio: 3 / 4;
        object-fit: cover;
      }
      .pb-grid-three__item figcaption {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid var(--pb-line);
      }
      .pb-grid-three__item figcaption em {
        font-family: var(--pb-serif);
        font-style: italic;
        font-size: 22px;
        letter-spacing: -0.01em;
      }
      .pb-grid-three__item figcaption span {
        font-family: var(--pb-sans);
        font-size: 11px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--pb-muted);
      }
      .pb-portfolio__notes {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
        max-width: 1200px;
        margin: 0 auto;
      }
      .pb-portfolio__note h5 {
        font-family: var(--pb-serif);
        font-size: 24px;
        font-style: italic;
        margin: 0 0 10px;
      }

      /* 18. Zigzag */
      .pb-portfolio--zigzag .pb-zigzag {
        display: flex;
        gap: 64px;
        align-items: center;
        margin: 0 0 120px;
      }
      .pb-portfolio--zigzag .pb-zigzag:last-child {
        margin-bottom: 0;
      }
      .pb-portfolio--zigzag .pb-zigzag--b {
        flex-direction: row-reverse;
      }
      .pb-zigzag__figure {
        margin: 0;
        flex: 1.15 1 0;
        min-width: 0;
      }
      .pb-zigzag__figure img {
        width: 100%;
        height: auto;
        max-height: 68vh;
        object-fit: contain;
      }
      .pb-zigzag__text {
        flex: 0.85 1 0;
        min-width: 0;
        max-width: 44ch;
      }
      .pb-zigzag--b .pb-zigzag__text {
        text-align: right;
        margin-left: auto;
      }
      .pb-zigzag__text h4 {
        font-family: var(--pb-serif);
        font-size: clamp(36px, 4vw, 64px);
        line-height: 1.02;
        letter-spacing: -0.01em;
        margin: 0 0 4px;
      }

      /* 19. Credits */
      .pb-credits {
        padding: 180px 40px 180px;
      }
      .pb-credits__inner {
        max-width: 780px;
        margin: 0 auto;
        text-align: center;
      }
      .pb-credits__group {
        margin: 60px 0;
      }
      .pb-credits__group h4 {
        font-family: var(--pb-sans);
        font-weight: 400;
        font-size: 11px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--pb-muted);
        margin: 0 0 20px;
      }
      .pb-credits__group ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .pb-credits__group ul li {
        font-family: var(--pb-serif);
        font-style: italic;
        font-size: clamp(20px, 2vw, 30px);
        line-height: 1.6;
        color: var(--pb-fg);
      }
      .pb-credits__index {
        columns: 2;
        column-gap: 40px;
        text-align: center;
        max-width: 520px;
        margin: 0 auto !important;
      }
      .pb-credits__index li {
        font-size: clamp(16px, 1.3vw, 20px) !important;
        break-inside: avoid;
      }
      .pb-credits__group p {
        font-family: var(--pb-serif);
        font-size: 18px;
        line-height: 1.6;
        color: var(--pb-fg);
        margin: 0;
      }

      /* 19b. Partners */
      .pb-partners {
        padding: 140px 40px 160px;
      }
      .pb-partners__inner {
        max-width: 980px;
        margin: 0 auto;
        text-align: center;
      }
      .pb-partners__mark {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin-bottom: 90px;
      }
      .pb-partners__line {
        width: 60px;
        height: 1px;
        background: var(--pb-line);
      }
      .pb-partners__grid {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        column-gap: 64px;
        row-gap: 72px;
        align-items: center;
        justify-items: center;
      }
      .pb-partners__cell {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 56px;
      }
      .pb-partners__cell img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        object-fit: contain;
        filter: grayscale(1);
        opacity: 0.78;
      }

      /* 20. End */
      .pb-end {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 80px 40px;
        gap: 28px;
      }
      .pb-end__mark {
        display: flex;
        align-items: center;
        gap: 18px;
      }
      .pb-end__line {
        width: 60px;
        height: 1px;
        background: var(--pb-muted);
      }
      .pb-end__year {
        font-family: var(--pb-serif);
        font-style: italic;
        font-size: 14px;
        letter-spacing: 0.4em;
        color: var(--pb-muted);
      }
      .pb-end__title {
        font-family: var(--pb-serif);
        font-size: clamp(48px, 6vw, 96px);
        letter-spacing: -0.01em;
        margin: 0;
      }
      .pb-end__tagline {
        font-family: var(--pb-serif);
        font-style: italic;
        font-size: 20px;
        color: var(--pb-muted);
        margin: 0;
      }

      /* Responsive */
      @media screen and (max-width: 900px) {
        .pb-topbar {
          position: static;
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 10px;
          padding: 12px 16px;
        }
        .pb-topbar__brand img {
          width: 48px;
          height: 48px;
        }
        .pb-topbar__brand span {
          font-size: 10px;
        }
        .pb-topbar__year {
          display: none;
        }
        .pb-topbar__actions {
          justify-content: center;
          gap: 14px;
        }
        .pb-topbar__button {
          padding: 7px 14px;
          font-size: 10px;
        }
        .pb-cover__content {
          padding: 72px 24px 48px;
        }
        .pb-cover__meta {
          flex-direction: column;
          gap: 6px;
          text-align: center;
        }
        .pb-cover__meta .pb-dot {
          display: none;
        }
        .pb-editorial {
          padding: 64px 24px 96px;
        }
        .pb-editorial--floated {
          margin-left: 0;
        }
        .pb-feature--split {
          grid-template-columns: 1fr !important;
        }
        .pb-divider {
          grid-template-columns: 1fr !important;
          padding: 48px 24px;
          min-height: auto;
        }
        .pb-divider--num-left .pb-divider__index,
        .pb-divider--num-left .pb-divider__label {
          grid-column: 1;
          justify-self: center;
          text-align: center;
        }
        .pb-divider__label h2 {
          font-size: clamp(40px, 10vw, 72px);
        }
        .pb-divider__label p {
          margin: 0 auto;
        }
        .pb-split__figure {
          min-height: 60vh;
        }
        .pb-bleed__figure {
          height: auto;
          min-height: 0;
        }
        .pb-bleed__figure img {
          height: auto;
        }
        .pb-split__text {
          padding: 48px 24px 96px;
        }
        .pb-divider__index {
          font-size: 30vw;
        }
        .pb-feature--quote {
          grid-template-columns: 1fr;
          padding: 120px 24px;
        }
        .pb-quote,
        .pb-quote__figure,
        .pb-quote__body {
          grid-column: 1;
          grid-row: auto;
        }
        .pb-feature--aside,
        .pb-feature--offset {
          grid-template-columns: 1fr;
          padding: 100px 24px;
        }
        .pb-offset__figure,
        .pb-offset__text {
          grid-column: 1;
          margin-top: 0;
        }
        .pb-triptych {
          grid-template-columns: 1fr;
          gap: 28px;
          margin-bottom: 100px;
        }
        .pb-triptych--left .pb-triptych__figure,
        .pb-triptych--right .pb-triptych__figure,
        .pb-triptych--left .pb-triptych__text,
        .pb-triptych--right .pb-triptych__text {
          grid-column: 1;
          order: initial;
        }
        .pb-portfolio--grid .pb-grid-three,
        .pb-portfolio__notes {
          grid-template-columns: 1fr;
        }
        .pb-portfolio--zigzag .pb-zigzag,
        .pb-portfolio--zigzag .pb-zigzag--b {
          flex-direction: column;
          gap: 28px;
        }
        .pb-portfolio--zigzag .pb-zigzag__text {
          text-align: left !important;
          margin-left: 0 !important;
        }
        .pb-toc {
          grid-template-columns: 1fr;
        }
        .pb-people {
          padding: 120px 24px 80px;
        }
        .pb-people__grid,
        .pb-people__grid--three {
          grid-template-columns: 1fr;
          gap: 48px;
        }
        .pb-credits__index {
          columns: 1;
        }
        .pb-partners {
          padding: 100px 24px 120px;
        }
        .pb-intro {
          padding: 140px 24px 100px;
        }
        .pb-toc {
          padding: 100px 24px 120px;
        }
        .pb-feature--stacked {
