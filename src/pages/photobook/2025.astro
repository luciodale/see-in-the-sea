---
export const prerender = true;

import '@/styles/global.css';
import { getPhotobook2025, type PhotobookLang } from '@/i18n/photobook-2025';

const lang: PhotobookLang = Astro.currentLocale === 'it' ? 'it' : 'en';
const content = getPhotobook2025(lang);
const {
  ui,
  meta,
  cover,
  bw,
  macro,
  wide,
  portfolio,
  leadership,
  leadershipNames,
  judges,
  photographerIndex,
  partners,
} = content;

const canonicalUrl = Astro.url.href;
const origin = new URL('/', canonicalUrl).toString();

const pathname = Astro.url.pathname;
const stripped = pathname.replace(/^\/it(?=\/|$)/, '') || '/';
const enUrl = stripped;
const itUrl = stripped === '/' ? '/it' : `/it${stripped}`;
const enFullUrl = new URL(enUrl, origin).toString();
const itFullUrl = new URL(itUrl, origin).toString();

const SITE_NAME = 'See in the Sea';
const YEAR = '2025';

const altSuffix =
  lang === 'it'
    ? `See in the Sea ${YEAR} concorso internazionale di fotografia subacquea`
    : `See in the Sea ${YEAR} international underwater photography contest`;

const placeLabel = (place: string) => (place && place !== '—' ? place : '');

const buildPhotoAlt = (
  title: string,
  photographer: string,
  place: string,
  categoryName: string,
  ordinal: string
) => {
  const parts = [
    `${title} by ${photographer}`,
    `${categoryName} ${ordinal} ${ui.placeSuffix}`,
    placeLabel(place),
    altSuffix,
  ].filter(Boolean);
  return parts.join(' — ');
};

const buildPortfolioAlt = (
  pieceTitle: string,
  pieceNumber: number,
  totalPieces: number,
  photographer: string,
  place: string,
  ordinal: string
) => {
  const triptychLabel =
    lang === 'it'
      ? `foto ${pieceNumber} di ${totalPieces}`
      : `photograph ${pieceNumber} of ${totalPieces}`;
  const parts = [
    `${pieceTitle} by ${photographer}`,
    `${ui.categories.portfolio} ${ordinal} ${ui.placeSuffix}`,
    triptychLabel,
    placeLabel(place),
    altSuffix,
  ].filter(Boolean);
  return parts.join(' — ');
};

const buildJudgeAlt = (name: string) =>
  lang === 'it'
    ? `${name}, giudice di See in the Sea ${YEAR}`
    : `${name}, See in the Sea ${YEAR} jury member - underwater photographer`;

const macroFirstAlt = buildPhotoAlt(
  macro.first.title,
  macro.first.photographer,
  macro.first.place,
  ui.categories.macro,
  ui.ordinals[0]
);

const bwAlts = [
  buildPhotoAlt(
    bw.first.title,
    bw.first.photographer,
    bw.first.place,
    ui.categories.bw,
    ui.ordinals[0]
  ),
  buildPhotoAlt(
    bw.second.title,
    bw.second.photographer,
    bw.second.place,
    ui.categories.bw,
    ui.ordinals[1]
  ),
  buildPhotoAlt(
    bw.third.title,
    bw.third.photographer,
    bw.third.place,
    ui.categories.bw,
    ui.ordinals[2]
  ),
];

const macroAlts = [
  macroFirstAlt,
  buildPhotoAlt(
    macro.second.title,
    macro.second.photographer,
    macro.second.place,
    ui.categories.macro,
    ui.ordinals[1]
  ),
  buildPhotoAlt(
    macro.third.title,
    macro.third.photographer,
    macro.third.place,
    ui.categories.macro,
    ui.ordinals[2]
  ),
];

const wideAlts = [
  buildPhotoAlt(
    wide.first.title,
    wide.first.photographer,
    wide.first.place,
    ui.categories.wide,
    ui.ordinals[0]
  ),
  buildPhotoAlt(
    wide.second.title,
    wide.second.photographer,
    wide.second.place,
    ui.categories.wide,
    ui.ordinals[1]
  ),
  buildPhotoAlt(
    wide.third.title,
    wide.third.photographer,
    wide.third.place,
    ui.categories.wide,
    ui.ordinals[2]
  ),
];

const ogImage = new URL(cover.image, canonicalUrl).toString();
const ogImageAlt = macroFirstAlt;

const seoKeywords = (
  lang === 'it'
    ? [
        'fotografia subacquea',
        'photobook subacqueo',
        'concorso fotografia subacquea',
        'fotografia marina',
        'See in the Sea 2025',
        'Ortona Sub',
        'fotografia mediterraneo',
      ]
    : [
        'underwater photography',
        'underwater photobook',
        'underwater photography contest',
        'marine photography',
        'See in the Sea 2025',
        'Ortona Sub',
        'Mediterranean underwater photography',
      ]
).join(', ');

type ImageObjectLd = {
  '@type': 'ImageObject';
  name: string;
  caption?: string;
  contentUrl: string;
  description?: string;
  creator: { '@type': 'Person'; name: string };
  copyrightHolder: { '@type': 'Person'; name: string };
  contentLocation?: { '@type': 'Place'; name: string };
};

const buildImageObject = (
  title: string,
  photographer: string,
  place: string,
  body: string,
  src: string
): ImageObjectLd => ({
  '@type': 'ImageObject',
  name: title,
  caption: body,
  description: body,
  contentUrl: new URL(src, origin).toString(),
  creator: { '@type': 'Person', name: photographer },
  copyrightHolder: { '@type': 'Person', name: photographer },
  ...(placeLabel(place)
    ? { contentLocation: { '@type': 'Place', name: place } }
    : {}),
});

const galleryImages: ImageObjectLd[] = [
  buildImageObject(
    bw.first.title,
    bw.first.photographer,
    bw.first.place,
    bw.first.body,
    bw.first.image
  ),
  buildImageObject(
    bw.second.title,
    bw.second.photographer,
    bw.second.place,
    bw.second.body,
    bw.second.image
  ),
  buildImageObject(
    bw.third.title,
    bw.third.photographer,
    bw.third.place,
    bw.third.body,
    bw.third.image
  ),
  buildImageObject(
    macro.first.title,
    macro.first.photographer,
    macro.first.place,
    macro.first.body,
    macro.first.image
  ),
  buildImageObject(
    macro.second.title,
    macro.second.photographer,
    macro.second.place,
    macro.second.body,
    macro.second.image
  ),
  buildImageObject(
    macro.third.title,
    macro.third.photographer,
    macro.third.place,
    macro.third.body,
    macro.third.image
  ),
  buildImageObject(
    wide.first.title,
    wide.first.photographer,
    wide.first.place,
    wide.first.body,
    wide.first.image
  ),
  buildImageObject(
    wide.second.title,
    wide.second.photographer,
    wide.second.place,
    wide.second.body,
    wide.second.image
  ),
  buildImageObject(
    wide.third.title,
    wide.third.photographer,
    wide.third.place,
    wide.third.body,
    wide.third.image
  ),
  ...(['first', 'second', 'third'] as const).flatMap(slot =>
    portfolio[slot].pieces.map(piece =>
      buildImageObject(
        piece.title,
        portfolio[slot].photographer,
        piece.place,
        piece.body,
        piece.image
      )
    )
  ),
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITE_NAME, item: origin },
    {
      '@type': 'ListItem',
      position: 2,
      name: meta.title,
      item: canonicalUrl,
    },
  ],
};

const imageGalleryLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: meta.title,
  description: meta.description,
  url: canonicalUrl,
  inLanguage: lang === 'it' ? 'it-IT' : 'en-GB',
  isPartOf: {
    '@type': 'CreativeWork',
    name: `${SITE_NAME} ${YEAR}`,
    url: new URL(`/contest/uw-${YEAR}`, origin).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'ASD Ortona Sub APS',
    url: origin,
  },
  image: galleryImages,
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: meta.title,
  description: meta.description,
  url: canonicalUrl,
  inLanguage: lang === 'it' ? 'it-IT' : 'en-GB',
  image: ogImage,
  datePublished: `${YEAR}-12-31`,
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: origin,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/logo.svg', origin).toString(),
    },
  },
  about: photographerIndex.map(name => ({
    '@type': 'Person',
    name,
  })),
};

const jsonLdScripts = [breadcrumbLd, imageGalleryLd, articleLd];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="keywords" content={seoKeywords} />

    <link rel="alternate" hreflang="en" href={enFullUrl} />
    <link rel="alternate" hreflang="it" href={itFullUrl} />
    <link rel="alternate" hreflang="x-default" href={enFullUrl} />

    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    {
      jsonLdScripts.map(ld => (
        <script type="application/ld+json" set:html={JSON.stringify(ld)} />
      ))
    }
  </head>
  <body class="pb-body">
    <!-- Top bar -->
    <header class="pb-topbar">
      <a href="/" class="pb-topbar__brand" aria-label="See in the Sea — home">
        <img src="/images/logo.svg" alt="" />
        <span>See in the Sea</span>
      </a>
      <div class="pb-topbar__year">MMXXV</div>
      <div class="pb-topbar__actions">
        <nav class="pb-lang" aria-label="Language">
          <a
            href={enUrl}
            class:list={[
              'pb-lang__link',
              { 'pb-lang__link--active': lang === 'en' },
            ]}
            aria-current={lang === 'en' ? 'true' : undefined}
            hreflang="en">EN</a
          >
          <span class="pb-lang__sep" aria-hidden="true">/</span>
          <a
            href={itUrl}
            class:list={[
              'pb-lang__link',
              { 'pb-lang__link--active': lang === 'it' },
            ]}
            aria-current={lang === 'it' ? 'true' : undefined}
            hreflang="it">IT</a
          >
        </nav>
        <button
          type="button"
          id="pb-print"
          class="pb-topbar__button"
          data-label-preparing={ui.preparing}
        >
          <span>{ui.downloadPdf}</span>
        </button>
      </div>
    </header>

    <main>
      <!-- 1. COVER -->
      <section class="pb-cover pb-page">
        <div class="pb-cover__image-wrap">
          <img
            src={cover.image}
            alt={macroFirstAlt}
            class="pb-cover__image"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
          <div class="pb-cover__vignette"></div>
        </div>

        <div class="pb-cover__content">
          <div class="pb-cover__kicker">
            <span>{ui.coverKicker}</span>
            <span class="pb-sep"></span>
            <span>{ui.coverSubline}</span>
          </div>
          <h1 class="pb-cover__title">
            <span class="pb-cover__title-sub">{ui.coverTitleSub}</span>
            <span class="pb-cover__title-year">2025</span>
          </h1>
          <div class="pb-cover__meta">
            <span>{ui.categories.bw}</span>
            <span class="pb-dot"></span>
            <span>{ui.categories.macro}</span>
            <span class="pb-dot"></span>
            <span>{ui.categories.wide}</span>
            <span class="pb-dot"></span>
            <span>{ui.categories.portfolio}</span>
          </div>
        </div>
      </section>

      <!-- 1b. LEADERSHIP -->
      <section class="pb-people pb-page">
        <div class="pb-people__inner">
          <h2 class="pb-people__title pb-reveal">
            {ui.leadershipTitlePrefix}<em>{ui.leadershipTitleEm}</em>
          </h2>
          <div class="pb-people__grid">
            {
              leadership.map((person) => (
                <article class="pb-person pb-reveal">
                  <p class="pb-person__role">{person.role}</p>
                  <h3 class="pb-person__name">
                    <em>{person.name}</em>
                  </h3>
                  <p class="pb-person__body">{person.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 1c. JUDGES -->
      <section class="pb-people pb-people--judges pb-page">
        <div class="pb-people__inner">
          <p class="pb-eyebrow pb-reveal">{ui.judgesEyebrow}</p>
          <h2 class="pb-people__title pb-reveal">
            {ui.judgesTitlePrefix}<em>{ui.judgesTitleEm}</em>
          </h2>
          <div
            class="pb-people__grid pb-people__grid--three pb-people__grid--portraits"
          >
            {
              judges.map((judge) => (
                <article class="pb-person pb-person--portrait pb-reveal">
                  <figure class="pb-person__portrait">
                    <img
                      src={judge.image}
                      alt={buildJudgeAlt(judge.name)}
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                  <h3 class="pb-person__name">
                    <em>{judge.name}</em>
                  </h3>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 2. EDITORIAL INTRO -->
      <section class="pb-intro pb-page">
        <div class="pb-intro__inner">
          <p class="pb-eyebrow pb-reveal">{ui.preface.eyebrow}</p>
          <h2 class="pb-intro__title pb-reveal">
            {ui.preface.titleLine1}<br />
            <em>{ui.preface.titleLine2Em}</em>
          </h2>
          <div class="pb-intro__body pb-reveal">
            <p>{ui.preface.paragraph1}</p>
            <p>{ui.preface.paragraph2}</p>
            <p>{ui.preface.paragraph3}</p>
          </div>
          <ol class="pb-toc pb-reveal">
            <li><span>01</span> {ui.categories.bw}</li>
            <li><span>02</span> {ui.categories.macro}</li>
            <li><span>03</span> {ui.categories.wide}</li>
            <li><span>04</span> {ui.categories.portfolio}</li>
          </ol>
        </div>
      </section>

      <!-- 3. DIVIDER 01 -->
      <section class="pb-divider pb-divider--num-left pb-page">
        <div class="pb-divider__index">01</div>
        <div class="pb-divider__label">
          <span class="pb-eyebrow">{ui.categoryEyebrow}</span>
          <h2>
            {ui.dividers.bw.titleLine1}<br /><em
              >{ui.dividers.bw.titleLine2Em}</em>
          </h2>
          <p>{ui.dividers.bw.sub}</p>
        </div>
      </section>

      <!-- 4. B&W 1st — FULL BLEED -->
      <section class="pb-feature pb-feature--bleed pb-page">
        <figure class="pb-bleed__figure pb-bleed__figure--natural">
          <img
            src={bw.first.image}
            alt={bwAlts[0]}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="pb-editorial pb-editorial--floated">
          <p class="pb-eyebrow pb-reveal">
            {ui.ordinals[0]}
            {ui.placeSuffix} — {ui.categories.bw}
          </p>
          <h3 class="pb-reveal">
            <em>{bw.first.title}</em>
          </h3>
          <p class="pb-author pb-reveal">
            {bw.first.photographer}, {bw.first.place}
          </p>
          <p class="pb-body-text pb-reveal">{bw.first.body}</p>
        </div>
      </section>

      <!-- 5. B&W 2nd — CENTERED PLATE -->
      <section class="pb-feature pb-feature--plate pb-page">
        <div class="pb-plate">
          <p class="pb-eyebrow pb-reveal">
            {ui.ordinals[1]}
            {ui.placeSuffix} — {ui.categories.bw}
          </p>
          <figure class="pb-plate__figure pb-reveal">
            <img
              src={bw.second.image}
              alt={bwAlts[1]}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="pb-plate__text">
            <h3 class="pb-reveal"><em>{bw.second.title}</em></h3>
            <p class="pb-author pb-reveal">
              {bw.second.photographer}, {bw.second.place}
            </p>
            <p class="pb-body-text pb-reveal">{bw.second.body}</p>
          </div>
        </div>
      </section>

      <!-- 6. B&W 3rd — SPLIT / IMAGE RIGHT -->
      <section class="pb-feature pb-feature--split pb-split--right pb-page">
        <div class="pb-split__text">
          <p class="pb-eyebrow pb-reveal">
            {ui.ordinals[2]}
            {ui.placeSuffix} — {ui.categories.bw}
          </p>
          <h3 class="pb-reveal">
            <em>{bw.third.title}</em>
          </h3>
          <p class="pb-author pb-reveal">
            {bw.third.photographer}, {bw.third.place}
          </p>
          <p class="pb-body-text pb-reveal">{bw.third.body}</p>
        </div>
        <figure class="pb-split__figure">
          <img
            src={bw.third.image}
            alt={bwAlts[2]}
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>

      <!-- 7. DIVIDER 02 -->
      <section class="pb-divider pb-divider--num-left pb-page">
        <div class="pb-divider__index">02</div>
        <div class="pb-divider__label">
          <span class="pb-eyebrow">{ui.categoryEyebrow}</span>
          <h2><em>{ui.dividers.macro.titleEm}</em></h2>
          <p>{ui.dividers.macro.sub}</p>
        </div>
      </section>

      <!-- 8. MACRO 1st — TITLE ABOVE + WIDE IMAGE -->
      <section class="pb-feature pb-feature--stacked pb-page">
        <header class="pb-stacked__head">
          <p class="pb-eyebrow pb-reveal">
            {ui.ordinals[0]}
            {ui.placeSuffix} — {ui.categories.macro}
          </p>
          <h3 class="pb-stacked__title pb-reveal">
            <em>{macro.first.title}</em>
          </h3>
          <p class="pb-author pb-reveal">
            {macro.first.photographer}, {macro.first.place}
          </p>
        </header>
        <figure class="pb-stacked__figure">
          <img
            src={macro.first.image}
            alt={macroAlts[0]}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <p class="pb-stacked__body pb-body-text pb-reveal">
          {macro.first.body}
        </p>
      </section>

      <!-- 9. MACRO 2nd — TECHNICAL / IMAGE LEFT BLEED + COLUMN RIGHT -->
      <section class="pb-feature pb-feature--split pb-split--left pb-page">
        <figure class="pb-split__figure pb-split__figure--bleed">
          <img
            src={macro.second.image}
            alt={macroAlts[1]}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="pb-split__text pb-split__text--narrow">
          <p class="pb-eyebrow pb-reveal">
            {ui.ordinals[1]}
            {ui.placeSuffix} — {ui.categories.macro}
          </p>
          <h3 class="pb-reveal"><em>{macro.second.title}</em></h3>
          <p class="pb-author pb-reveal">
            <span>{macro.second.photographer}</span>
          </p>
          <p class="pb-body-text pb-reveal">
            {macro.second.body}
          </p>
        </div>
      </section>

      <!-- 10. MACRO 3rd — EDITORIAL QUOTE -->
      <section class="pb-feature pb-feature--quote pb-page">
        <blockquote class="pb-quote pb-reveal">
          <p>
            {ui.macroQuote.line1}<br />
            {ui.macroQuote.line2Prefix}<em>{ui.macroQuote.line2Em}</em>
          </p>
          <footer>
            {macro.third.title}, {macro.third.photographer}, {macro.third.place}
          </footer>
        </blockquote>
        <figure class="pb-quote__figure pb-reveal">
          <img
            src={macro.third.image}
            alt={macroAlts[2]}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <p class="pb-quote__body pb-body-text pb-reveal">{macro.third.body}</p>
      </section>

      <!-- 11. DIVIDER 03 -->
      <section class="pb-divider pb-divider--num-left pb-page">
        <div class="pb-divider__index">03</div>
        <div class="pb-divider__label">
          <span class="pb-eyebrow">{ui.categoryEyebrow}</span>
          <h2>
            {ui.dividers.wide.titleLine1}<br /><em
              >{ui.dividers.wide.titleLine2Em}</em>
          </h2>
          <p>{ui.dividers.wide.sub}</p>
        </div>
      </section>

      <!-- 12. WIDE 1st — FULL BLEED -->
      <section class="pb-feature pb-feature--bleed pb-page">
        <figure class="pb-bleed__figure">
          <img
            src={wide.first.image}
            alt={wideAlts[0]}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="pb-editorial pb-editorial--centered">
          <p class="pb-eyebrow pb-reveal">
            {ui.ordinals[0]}
            {ui.placeSuffix} — {ui.categories.wide}
          </p>
          <h3 class="pb-reveal"><em>{wide.first.title}</em></h3>
          <p class="pb-author pb-reveal">
            {wide.first.photographer}, {wide.first.place}
          </p>
          <p class="pb-body-text pb-reveal">{wide.first.body}</p>
        </div>
      </section>

      <!-- 13. WIDE 2nd — DIAGONAL / OFFSET -->
      <section class="pb-feature pb-feature--offset pb-page">
        <figure class="pb-offset__figure pb-reveal">
          <img
            src={wide.second.image}
            alt={wideAlts[1]}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="pb-offset__text pb-reveal">
          <p class="pb-eyebrow">
            {ui.ordinals[1]}
