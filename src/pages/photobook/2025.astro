          transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
        will-change: opacity, transform;
      }
      .pb-reveal.pb-in {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      /* Top bar */
      .pb-topbar {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 50;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 20px 28px;
        background: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.6),
          rgba(0, 0, 0, 0)
        );
        pointer-events: none;
      }
      .pb-topbar > * {
        pointer-events: auto;
      }
      .pb-topbar__brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--pb-fg);
        text-decoration: none;
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }
      .pb-topbar__brand img {
        width: 22px;
        height: 22px;
      }
      .pb-topbar__brand span {
        opacity: 0.82;
      }
      .pb-topbar__year {
        font-family: var(--pb-serif);
        font-style: italic;
        font-size: 15px;
        letter-spacing: 0.3em;
        color: var(--pb-fg);
