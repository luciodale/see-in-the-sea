---
export const prerender = true;

import '@/styles/global.css';
import {
  getPhotobook2025,
  type PhotobookLang,
} from '@/i18n/photobook-2025';

const lang: PhotobookLang = Astro.currentLocale === 'it' ? 'it' : 'en';
const content = getPhotobook2025(lang);
const { ui, meta, cover, bw, macro, wide, portfolio, leadership, judges, photographerIndex } = content;

const canonicalUrl = Astro.url.href;

const pathname = Astro.url.pathname;
const stripped = pathname.replace(/^\/it(?=\/|$)/, '') || '/';
const enUrl = stripped;
const itUrl = stripped === '/' ? '/it' : `/it${stripped}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(cover.image, canonicalUrl).toString()} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="pb-body">
    <!-- Top bar -->
    <header class="pb-topbar">
      <a href="/" class="pb-topbar__brand" aria-label="See in the Sea — home">
        <img src="/images/logo.svg" alt="" />
        <span>See in the Sea</span>
      </a>
      <div class="pb-topbar__year">MMXXV</div>
      <div class="pb-topbar__actions">
        <nav class="pb-lang" aria-label="Language">
          <a
            href={enUrl}
            class:list={['pb-lang__link', { 'pb-lang__link--active': lang === 'en' }]}
            aria-current={lang === 'en' ? 'true' : undefined}
            hreflang="en"
          >EN</a>
          <span class="pb-lang__sep" aria-hidden="true">/</span>
          <a
            href={itUrl}
            class:list={['pb-lang__link', { 'pb-lang__link--active': lang === 'it' }]}
            aria-current={lang === 'it' ? 'true' : undefined}
            hreflang="it"
          >IT</a>
        </nav>
        <button
          type="button"
          id="pb-print"
          class="pb-topbar__button"
          data-label-preparing={ui.preparing}
        >
          <span>{ui.downloadPdf}</span>
        </button>
      </div>
    </header>

    <main>
      <!-- 1. COVER -->
      <section class="pb-cover pb-page">
        <div class="pb-cover__image-wrap">
          <img
            src={cover.image}
            alt={cover.alt}
            class="pb-cover__image"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
          <div class="pb-cover__vignette"></div>
        </div>

        <div class="pb-cover__content">
          <div class="pb-cover__kicker">
            <span>{ui.coverKicker}</span>
            <span class="pb-sep"></span>
            <span>{ui.coverSubline}</span>
          </div>
          <h1 class="pb-cover__title">
            <span class="pb-cover__title-sub">{ui.coverTitleSub}</span>
            <span class="pb-cover__title-year">2025</span>
          </h1>
          <div class="pb-cover__meta">
            <span>{ui.categories.bw}</span>
            <span class="pb-dot"></span>
            <span>{ui.categories.macro}</span>
            <span class="pb-dot"></span>
            <span>{ui.categories.wide}</span>
            <span class="pb-dot"></span>
            <span>{ui.categories.portfolio}</span>
          </div>
        </div>

      </section>

      <!-- 1b. LEADERSHIP -->
      <section class="pb-people pb-page">
        <div class="pb-people__inner">
          <h2 class="pb-people__title pb-reveal">
            {ui.leadershipTitlePrefix}<em>{ui.leadershipTitleEm}</em>
          </h2>
          <div class="pb-people__grid">
            {leadership.map(person => (
              <article class="pb-person pb-reveal">
                <p class="pb-person__role">{person.role}</p>
                <h3 class="pb-person__name"><em>{person.name}</em></h3>
                <p class="pb-person__body">{person.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 1c. JUDGES -->
      <section class="pb-people pb-people--judges pb-page">
        <div class="pb-people__inner">
          <p class="pb-eyebrow pb-reveal">{ui.judgesEyebrow}</p>
          <h2 class="pb-people__title pb-reveal">
            {ui.judgesTitlePrefix}<em>{ui.judgesTitleEm}</em>
          </h2>
          <div class="pb-people__grid pb-people__grid--three">
            {judges.map(judge => (
              <article class="pb-person pb-reveal">
                <h3 class="pb-person__name"><em>{judge.name}</em></h3>
                <p class="pb-person__body">{judge.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 2. EDITORIAL INTRO -->
      <section class="pb-intro pb-page">
        <div class="pb-intro__inner">
          <p class="pb-eyebrow pb-reveal">{ui.preface.eyebrow}</p>
          <h2 class="pb-intro__title pb-reveal">
            {ui.preface.titleLine1}<br />
            <em>{ui.preface.titleLine2Em}</em>
          </h2>
          <div class="pb-intro__body pb-reveal">
            <p>{ui.preface.paragraph1}</p>
            <p>{ui.preface.paragraph2}</p>
          </div>
          <ol class="pb-toc pb-reveal">
            <li><span>01</span> {ui.categories.bw}</li>
            <li><span>02</span> {ui.categories.macro}</li>
            <li><span>03</span> {ui.categories.wide}</li>
            <li><span>04</span> {ui.categories.portfolio}</li>
          </ol>
        </div>
      </section>

      <!-- 3. DIVIDER 01 -->
      <section class="pb-divider pb-divider--num-left pb-page">
        <div class="pb-divider__index">01</div>
        <div class="pb-divider__label">
          <span class="pb-eyebrow">{ui.categoryEyebrow}</span>
          <h2>{ui.dividers.bw.titleLine1}<br /><em>{ui.dividers.bw.titleLine2Em}</em></h2>
          <p>{ui.dividers.bw.sub}</p>
        </div>
      </section>

      <!-- 4. B&W 1st — FULL BLEED -->
      <section class="pb-feature pb-feature--bleed pb-page">
        <figure class="pb-bleed__figure pb-bleed__figure--natural">
          <img
            src={bw.first.image}
            alt={`${bw.first.title} — ${bw.first.photographer}`}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="pb-editorial pb-editorial--floated">
          <p class="pb-eyebrow pb-reveal">{ui.ordinals[0]} {ui.placeSuffix} — {ui.categories.bw}</p>
          <h3 class="pb-reveal">
            <em>{bw.first.title}</em>
          </h3>
          <p class="pb-author pb-reveal">
            {bw.first.photographer}, {bw.first.place}
          </p>
          <p class="pb-body-text pb-reveal">{bw.first.body}</p>
        </div>
      </section>

      <!-- 5. B&W 2nd — CENTERED PLATE -->
      <section class="pb-feature pb-feature--plate pb-page">
        <div class="pb-plate">
          <p class="pb-eyebrow pb-reveal">{ui.ordinals[1]} {ui.placeSuffix} — {ui.categories.bw}</p>
          <figure class="pb-plate__figure pb-reveal">
            <img
              src={bw.second.image}
              alt={`${bw.second.title} — ${bw.second.photographer}`}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="pb-plate__text">
            <h3 class="pb-reveal"><em>{bw.second.title}</em></h3>
            <p class="pb-author pb-reveal">
              {bw.second.photographer}, {bw.second.place}
            </p>
            <p class="pb-body-text pb-reveal">{bw.second.body}</p>
          </div>
        </div>
      </section>

      <!-- 6. B&W 3rd — SPLIT / IMAGE RIGHT -->
      <section class="pb-feature pb-feature--split pb-split--right pb-page">
        <div class="pb-split__text">
          <p class="pb-eyebrow pb-reveal">{ui.ordinals[2]} {ui.placeSuffix} — {ui.categories.bw}</p>
          <h3 class="pb-reveal">
            <em>{bw.third.title}</em>
          </h3>
          <p class="pb-author pb-reveal">
            {bw.third.photographer}, {bw.third.place}
          </p>
          <p class="pb-body-text pb-reveal">{bw.third.body}</p>
        </div>
        <figure class="pb-split__figure">
          <img
            src={bw.third.image}
            alt={`${bw.third.title} — ${bw.third.photographer}`}
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>

      <!-- 7. DIVIDER 02 -->
      <section class="pb-divider pb-divider--num-left pb-page">
        <div class="pb-divider__index">02</div>
        <div class="pb-divider__label">
          <span class="pb-eyebrow">{ui.categoryEyebrow}</span>
          <h2><em>{ui.dividers.macro.titleEm}</em></h2>
          <p>{ui.dividers.macro.sub}</p>
        </div>
      </section>

      <!-- 8. MACRO 1st — TITLE ABOVE + WIDE IMAGE -->
      <section class="pb-feature pb-feature--stacked pb-page">
        <header class="pb-stacked__head">
          <p class="pb-eyebrow pb-reveal">{ui.ordinals[0]} {ui.placeSuffix} — {ui.categories.macro}</p>
          <h3 class="pb-stacked__title pb-reveal">
            <em>{macro.first.title}</em>
          </h3>
          <p class="pb-author pb-reveal">
            {macro.first.photographer}, {macro.first.place}
          </p>
        </header>
        <figure class="pb-stacked__figure">
          <img
            src={macro.first.image}
            alt={`${macro.first.title} — ${macro.first.photographer}`}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <p class="pb-stacked__body pb-body-text pb-reveal">{macro.first.body}</p>
      </section>

      <!-- 9. MACRO 2nd — TECHNICAL / IMAGE LEFT BLEED + COLUMN RIGHT -->
      <section class="pb-feature pb-feature--split pb-split--left pb-page">
        <figure class="pb-split__figure pb-split__figure--bleed">
          <img
            src={macro.second.image}
            alt={`${macro.second.title} — ${macro.second.photographer}`}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="pb-split__text pb-split__text--narrow">
          <p class="pb-eyebrow pb-reveal">{ui.ordinals[1]} {ui.placeSuffix} — {ui.categories.macro}</p>
          <h3 class="pb-reveal"><em>{macro.second.title}</em></h3>
          <p class="pb-author pb-reveal">
            <span>{macro.second.photographer}</span>
          </p>
          <p class="pb-body-text pb-reveal">
            {macro.second.body}
          </p>
        </div>
      </section>

      <!-- 10. MACRO 3rd — EDITORIAL QUOTE -->
      <section class="pb-feature pb-feature--quote pb-page">
        <blockquote class="pb-quote pb-reveal">
          <p>
            {ui.macroQuote.line1}<br />
            {ui.macroQuote.line2Prefix}<em>{ui.macroQuote.line2Em}</em>
          </p>
          <footer>
            {macro.third.title}, {macro.third.photographer}, {macro.third.place}
          </footer>
        </blockquote>
        <figure class="pb-quote__figure pb-reveal">
          <img
            src={macro.third.image}
            alt={`${macro.third.title} — ${macro.third.photographer}`}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <p class="pb-quote__body pb-body-text pb-reveal">{macro.third.body}</p>
      </section>

      <!-- 11. DIVIDER 03 -->
      <section class="pb-divider pb-divider--num-left pb-page">
        <div class="pb-divider__index">03</div>
        <div class="pb-divider__label">
          <span class="pb-eyebrow">{ui.categoryEyebrow}</span>
          <h2>{ui.dividers.wide.titleLine1}<br /><em>{ui.dividers.wide.titleLine2Em}</em></h2>
          <p>{ui.dividers.wide.sub}</p>
        </div>
      </section>

      <!-- 12. WIDE 1st — FULL BLEED -->
      <section class="pb-feature pb-feature--bleed pb-page">
        <figure class="pb-bleed__figure">
          <img
            src={wide.first.image}
            alt={`${wide.first.title} — ${wide.first.photographer}`}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="pb-editorial pb-editorial--centered">
          <p class="pb-eyebrow pb-reveal">{ui.ordinals[0]} {ui.placeSuffix} — {ui.categories.wide}</p>
          <h3 class="pb-reveal"><em>{wide.first.title}</em></h3>
          <p class="pb-author pb-reveal">
            {wide.first.photographer}, {wide.first.place}
          </p>
          <p class="pb-body-text pb-reveal">{wide.first.body}</p>
        </div>
      </section>

      <!-- 13. WIDE 2nd — DIAGONAL / OFFSET -->
      <section class="pb-feature pb-feature--offset pb-page">
        <figure class="pb-offset__figure pb-reveal">
          <img
            src={wide.second.image}
            alt={`${wide.second.title} — ${wide.second.photographer}`}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="pb-offset__text pb-reveal">
          <p class="pb-eyebrow">{ui.ordinals[1]} {ui.placeSuffix} — {ui.categories.wide}</p>
          <h3><em>{wide.second.title}</em></h3>
          <p class="pb-author">
            {wide.second.photographer}, {wide.second.place}
          </p>
          <p class="pb-body-text">{wide.second.body}</p>
        </div>
      </section>

      <!-- 14. WIDE 3rd — SMALL IMAGE + PULL QUOTE -->
      <section class="pb-feature pb-feature--aside pb-page">
        <div class="pb-aside__text">
          <p class="pb-eyebrow pb-reveal">{ui.ordinals[2]} {ui.placeSuffix} — {ui.categories.wide}</p>
          <h3 class="pb-aside__title pb-reveal">
            <em>{wide.third.title}</em>
          </h3>
          <p class="pb-author pb-reveal">
            {wide.third.photographer}, {wide.third.place}
          </p>
          <p class="pb-body-text pb-reveal">{wide.third.body}</p>
        </div>
        <figure class="pb-aside__figure pb-reveal">
          <img
            src={wide.third.image}
            alt={`${wide.third.title} — ${wide.third.photographer}`}
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>

      <!-- 15. DIVIDER 04 -->
      <section class="pb-divider pb-divider--num-left pb-page">
        <div class="pb-divider__index">04</div>
        <div class="pb-divider__label">
          <span class="pb-eyebrow">{ui.categoryEyebrow}</span>
          <h2>{ui.dividers.portfolio.titleLine1}<br /><em>{ui.dividers.portfolio.titleLine2Em}</em></h2>
          <p>{ui.dividers.portfolio.sub}</p>
        </div>
      </section>

      <!-- 16. PORTFOLIO 1st (Roscigno) — ALTERNATING BLEED -->
      <section class="pb-portfolio pb-page">
        <header class="pb-portfolio__head">
          <p class="pb-eyebrow pb-reveal">{ui.ordinals[0]} {ui.placeSuffix} — {ui.categories.portfolio}</p>
          <h3 class="pb-portfolio__name pb-reveal">
            <em>{portfolio.first.photographer}</em>
          </h3>
        </header>
        {portfolio.first.pieces.map((piece, idx) => (
          <article class={`pb-triptych pb-triptych--${idx % 2 === 0 ? 'left' : 'right'}`}>
            <figure class="pb-triptych__figure">
              <img
                src={piece.image}
                alt={`${piece.title} — ${portfolio.first.photographer}`}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="pb-triptych__text pb-reveal">
              <span class="pb-triptych__num">{String(idx + 1).padStart(2, '0')}</span>
              <h4><em>{piece.title}</em></h4>
              <p class="pb-place">{piece.place}</p>
              <p class="pb-body-text">{piece.body}</p>
            </div>
          </article>
        ))}
      </section>

      <!-- 17. PORTFOLIO 2nd (Visintin) — ZIG-ZAG ALTERNATING -->
      <section class="pb-portfolio pb-portfolio--zigzag pb-page">
        <header class="pb-portfolio__head">
          <p class="pb-eyebrow pb-reveal">{ui.ordinals[1]} {ui.placeSuffix} — {ui.categories.portfolio}</p>
          <h3 class="pb-portfolio__name pb-reveal">
            <em>{portfolio.second.photographer}</em>
          </h3>
        </header>
        {portfolio.second.pieces.map((piece, idx) => (
          <article class={`pb-zigzag pb-zigzag--${idx % 2 === 0 ? 'a' : 'b'}`}>
            <figure class="pb-zigzag__figure">
              <img
                src={piece.image}
                alt={`${piece.title} — ${portfolio.second.photographer}`}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="pb-zigzag__text pb-reveal">
              <h4><em>{piece.title}</em></h4>
              <p class="pb-place">{piece.place}</p>
              <p class="pb-body-text">{piece.body}</p>
            </div>
          </article>
        ))}
      </section>

      <!-- 18. PORTFOLIO 3rd (Casanovas) — ALTERNATING BLEED (triptych) -->
      <section class="pb-portfolio pb-page">
        <header class="pb-portfolio__head">
          <p class="pb-eyebrow pb-reveal">{ui.ordinals[2]} {ui.placeSuffix} — {ui.categories.portfolio}</p>
          <h3 class="pb-portfolio__name pb-reveal">
            <em>{portfolio.third.photographer}</em>
          </h3>
        </header>
        {portfolio.third.pieces.map((piece, idx) => (
          <article class={`pb-triptych pb-triptych--${idx % 2 === 0 ? 'left' : 'right'}`}>
            <figure class="pb-triptych__figure">
              <img
                src={piece.image}
                alt={`${piece.title} — ${portfolio.third.photographer}`}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="pb-triptych__text pb-reveal">
              <span class="pb-triptych__num">{String(idx + 1).padStart(2, '0')}</span>
              <h4><em>{piece.title}</em></h4>
              <p class="pb-place">{piece.place}</p>
              <p class="pb-body-text">{piece.body}</p>
            </div>
          </article>
        ))}
      </section>

      <!-- 19. CREDITS -->
      <section class="pb-credits pb-page">
        <div class="pb-credits__inner">
          <p class="pb-eyebrow pb-reveal">{ui.credits.eyebrow}</p>

          <div class="pb-credits__group pb-reveal">
            <h4>{ui.credits.direzione}</h4>
            <ul>
              {leadership.map(person => <li>{person.name}</li>)}
            </ul>
          </div>

          <div class="pb-credits__group pb-reveal">
            <h4>{ui.credits.giuria}</h4>
            <ul>
              {judges.map(judge => <li>{judge.name}</li>)}
            </ul>
          </div>

          <div class="pb-credits__group pb-reveal">
            <h4>{ui.credits.autori}</h4>
            <ul class="pb-credits__index">
              {photographerIndex.map(name => <li>{name}</li>)}
            </ul>
          </div>

          <div class="pb-credits__group pb-reveal">
            <h4>{ui.credits.aCuraDi}</h4>
            <p>
              {ui.credits.aCuraDiLine1}<br />
              {ui.credits.aCuraDiLine2}
            </p>
          </div>
        </div>
      </section>

      <!-- 20. END CARD -->
      <section class="pb-end pb-page">
        <div class="pb-end__mark">
          <span class="pb-end__line"></span>
          <span class="pb-end__year">MMXXV</span>
          <span class="pb-end__line"></span>
        </div>
        <h2 class="pb-end__title">
          See in the Sea
        </h2>
        <p class="pb-end__tagline"><em>{ui.endFine}</em></p>
      </section>
    </main>

    <script>
      // Reveal on scroll
      const els = document.querySelectorAll('.pb-reveal');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          entries => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('pb-in');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        for (const el of els) io.observe(el);
      } else {
        for (const el of els) el.classList.add('pb-in');
      }

      // Download → continuous single-page PDF (no pagination)
      const printBtn = document.getElementById('pb-print');
      if (printBtn) {
        printBtn.addEventListener('click', async () => {
          const btn = printBtn as HTMLButtonElement;
          const originalText = btn.textContent;
          const preparingLabel = btn.dataset.labelPreparing ?? 'Preparing…';
          btn.disabled = true;
          const btnLabel = btn.querySelector('span');
          if (btnLabel) btnLabel.textContent = preparingLabel;

          // Force all images to load (lazy ones far down haven't loaded yet,
          // so their heights measure as 0 and images render blank in print)
          const imgs = Array.from(document.querySelectorAll('img'));
          for (const img of imgs) {
            img.loading = 'eager';
          }
          await Promise.all(
            imgs.map(img => {
              if (img.complete && img.naturalHeight !== 0) return null;
              return new Promise(resolve => {
                img.addEventListener('load', resolve, { once: true });
                img.addEventListener('error', resolve, { once: true });
              });
            })
          );
          // Extra frame for layout to settle after images paint
          await new Promise(r => requestAnimationFrame(r));
          await new Promise(r => requestAnimationFrame(r));

          const width = window.innerWidth;
          const viewportHeight = window.innerHeight;
          void document.body.offsetHeight;
          // Use bottom of the last rendered section rather than scrollHeight
          // (scrollHeight can include trailing html/body padding that prints
          // as empty black space at the end of the PDF)
          const pages = document.querySelectorAll('.pb-page');
          const last = pages[pages.length - 1];
          const lastBottom = last
            ? last.getBoundingClientRect().bottom + window.scrollY
            : document.documentElement.scrollHeight;
          const rawHeight = Math.ceil(lastBottom);
          // Chrome's PDF engine caps single-page dimensions around
          // 200 inches ≈ 19,200px at 96 DPI. If content is taller we scale
          // the whole document down with CSS zoom so it fits on ONE page.
          const MAX_PAGE_PX = 18000;
          const zoom = rawHeight > MAX_PAGE_PX ? MAX_PAGE_PX / rawHeight : 1;
          const totalHeight = Math.ceil(rawHeight * zoom);
          const pageWidth = Math.ceil(width * zoom);

          const style = document.createElement('style');
          style.id = 'pb-print-continuous';
          style.textContent = `
            @page {
              size: ${pageWidth}px ${totalHeight}px !important;
              margin: 0 !important;
            }
            @media print {
              html {
                zoom: ${zoom} !important;
              }
              html, body {
                width: ${width}px !important;
                height: ${rawHeight}px !important;
                overflow: visible !important;
                background: #000 !important;
                margin: 0 !important;
                padding: 0 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                color-adjust: exact;
              }
              main {
                margin: 0 !important;
                padding: 0 !important;
              }
              .pb-page:last-of-type {
                margin-bottom: 0 !important;
                padding-bottom: 0 !important;
              }
              .pb-topbar {
                display: none !important;
              }
              .pb-reveal {
                opacity: 1 !important;
                transform: none !important;
              }
              /* Kill every page break rule — one giant page */
              *, *::before, *::after {
                page-break-before: auto !important;
                page-break-after: auto !important;
                page-break-inside: auto !important;
                break-before: auto !important;
                break-after: auto !important;
                break-inside: auto !important;
              }
              /* Universal reset: neutralise every vh-based height.
                 In print context vh == @page height (tens of thousands of px),
                 which blows up any element that uses it. */
              *, *::before, *::after {
                min-height: 0 !important;
                max-height: none !important;
              }
              /* Black surface on every page section */
              .pb-page {
                background: #000 !important;
                min-height: ${viewportHeight}px !important;
              }
              /* Cover + full-bleed figures pinned to one screen height */
              .pb-cover,
              .pb-cover__image-wrap {
                height: ${viewportHeight}px !important;
              }
              .pb-bleed__figure {
                height: ${viewportHeight}px !important;
                min-height: ${viewportHeight}px !important;
              }
              .pb-bleed__figure--natural {
                height: auto !important;
                min-height: 0 !important;
              }
              .pb-split__figure {
                min-height: ${viewportHeight}px !important;
              }
              .pb-feature--bleed .pb-editorial {
                padding-top: 120px !important;
              }
            }
          `;
          document.head.appendChild(style);

          function cleanup() {
            if (style.parentNode) style.remove();
            btn.disabled = false;
            if (btnLabel && originalText) btnLabel.textContent = originalText;
            window.removeEventListener('afterprint', cleanup);
          }
          window.addEventListener('afterprint', cleanup);

          // Let layout settle before triggering print
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              window.print();
              // Fallback if afterprint doesn't fire
              setTimeout(cleanup, 4000);
            });
          });
        });
      }
    </script>

    <style is:global>
      :root {
        --pb-bg: #000;
        --pb-fg: #f4f2ee;
        --pb-muted: #8e8a82;
