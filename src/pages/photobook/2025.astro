      .pb-topbar__actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 18px;
      }
      .pb-lang {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--pb-sans);
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }
      .pb-lang__link {
        color: var(--pb-muted);
        text-decoration: none;
        transition: color 0.3s ease;
      }
      .pb-lang__link:hover {
        color: var(--pb-fg);
      }
      .pb-lang__link--active {
        color: var(--pb-fg);
        pointer-events: none;
      }
      .pb-lang__sep {
        color: var(--pb-line);
      }
      .pb-topbar__button {
        appearance: none;
        border: 1px solid var(--pb-line);
        background: rgba(255, 255, 255, 0.02);
        color: var(--pb-fg);
        padding: 9px 18px;
        border-radius: 999px;
        font-family: var(--pb-sans);
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        cursor: pointer;
        transition:
          background 0.3s ease,
          border-color 0.3s ease,
          color 0.3s ease;
      }
      .pb-topbar__button:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.35);
