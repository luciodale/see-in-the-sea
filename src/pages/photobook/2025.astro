    <script>
      // Reveal on scroll
      const els = document.querySelectorAll(".pb-reveal");
      if ("IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("pb-in");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        for (const el of els) io.observe(el);
      } else {
        for (const el of els) el.classList.add("pb-in");
      }

      // Download → continuous single-page PDF (no pagination)
      const printBtn = document.getElementById("pb-print");
      if (printBtn) {
        printBtn.addEventListener("click", async () => {
          const btn = printBtn as HTMLButtonElement;
          const originalText = btn.textContent;
          const preparingLabel = btn.dataset.labelPreparing ?? "Preparing…";
          btn.disabled = true;
          const btnLabel = btn.querySelector("span");
          if (btnLabel) btnLabel.textContent = preparingLabel;

          // Force all images to load (lazy ones far down haven't loaded yet,
          // so their heights measure as 0 and images render blank in print)
          const imgs = Array.from(document.querySelectorAll("img"));
          for (const img of imgs) {
            img.loading = "eager";
          }
          await Promise.all(
            imgs.map((img) => {
              if (img.complete && img.naturalHeight !== 0) return null;
              return new Promise((resolve) => {
                img.addEventListener("load", resolve, { once: true });
                img.addEventListener("error", resolve, { once: true });
              });
            }),
          );
          // Extra frame for layout to settle after images paint
          await new Promise((r) => requestAnimationFrame(r));
          await new Promise((r) => requestAnimationFrame(r));

          const width = window.innerWidth;
          const viewportHeight = window.innerHeight;
          void document.body.offsetHeight;
          // Use bottom of the last rendered section rather than scrollHeight
          // (scrollHeight can include trailing html/body padding that prints
          // as empty black space at the end of the PDF)
          const pages = document.querySelectorAll(".pb-page");
          const last = pages[pages.length - 1];
          const lastBottom = last
            ? last.getBoundingClientRect().bottom + window.scrollY
            : document.documentElement.scrollHeight;
          // Print CSS below forces every .pb-page to min-height: viewportHeight
          // for aesthetic reasons. Naturally short sections (credits, partners)
          // grow at print time and push later content past what was measured
          // pre-print — clipping the End card. Simulate that growth here so
          // rawHeight matches what Chrome will actually render.
          let totalPrintHeight = 0;
          for (const page of pages) {
            const h = (page as HTMLElement).getBoundingClientRect().height;
            totalPrintHeight += Math.max(h, viewportHeight);
          }
          const rawHeight = Math.ceil(
            Math.max(
              totalPrintHeight,
              lastBottom,
              document.documentElement.scrollHeight,
            ),
          );
          // Chrome's PDF engine handles very tall @page sizes in modern
          // versions. Only scale down with CSS zoom if content exceeds this
          // cap — keep it generous so normal-sized books render as ONE page
          // without triggering the zoom path (which Chrome print preview
          // does not always fold into a single page reliably).
          const MAX_PAGE_PX = 32000;
          // Shrink slightly under the cap so sub-pixel rounding can't push
          // content to a 2nd page.
          const zoom =
            rawHeight > MAX_PAGE_PX ? (MAX_PAGE_PX - 8) / rawHeight : 1;
          // Buffer so the @page box is strictly >= content even under
          // sub-pixel rounding. Kept generous to guarantee the End card
          // isn't clipped at the bottom edge.
          const PAGE_BUFFER_PX = 48;
          const totalHeight = Math.ceil(rawHeight * zoom) + PAGE_BUFFER_PX;
          const pageWidth = Math.ceil(width * zoom);

          const style = document.createElement("style");
          style.id = "pb-print-continuous";
          style.textContent = `
            @page {
              size: ${pageWidth}px ${totalHeight}px !important;
              margin: 0 !important;
            }
            @media print {
              html {
                zoom: ${zoom} !important;
              }
              html, body {
                width: ${width}px !important;
                height: ${rawHeight}px !important;
                overflow: hidden !important;
                background: #000 !important;
                margin: 0 !important;
                padding: 0 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                color-adjust: exact;
              }
              main {
                margin: 0 !important;
                padding: 0 !important;
              }
              .pb-page:last-of-type {
                margin-bottom: 0 !important;
                padding-bottom: 0 !important;
              }
              .pb-topbar {
                display: none !important;
              }
              .pb-reveal {
                opacity: 1 !important;
                transform: none !important;
              }
              /* Kill every page break rule — one giant page */
              *, *::before, *::after {
                page-break-before: auto !important;
                page-break-after: auto !important;
                page-break-inside: auto !important;
                break-before: auto !important;
                break-after: auto !important;
                break-inside: auto !important;
              }
              /* Universal reset: neutralise every vh-based height.
                 In print context vh == @page height (tens of thousands of px),
                 which blows up any element that uses it. */
              *, *::before, *::after {
                min-height: 0 !important;
                max-height: none !important;
              }
              /* Black surface on every page section */
              .pb-page {
                background: #000 !important;
                min-height: ${viewportHeight}px !important;
              }
              /* Cover + full-bleed figures pinned to one screen height */
              .pb-cover,
              .pb-cover__image-wrap {
                height: ${viewportHeight}px !important;
              }
              /* Pin the end card so its min-height can't drift post-measure */
              .pb-end {
                height: ${viewportHeight}px !important;
                min-height: ${viewportHeight}px !important;
              }
              .pb-bleed__figure {
                height: ${viewportHeight}px !important;
                min-height: ${viewportHeight}px !important;
              }
              .pb-bleed__figure--natural {
                height: auto !important;
                min-height: 0 !important;
              }
              .pb-split__figure {
                min-height: ${viewportHeight}px !important;
              }
              .pb-feature--bleed .pb-editorial {
                padding-top: 120px !important;
              }
            }
          `;
          document.head.appendChild(style);

          function cleanup() {
            if (style.parentNode) style.remove();
            btn.disabled = false;
            if (btnLabel && originalText) btnLabel.textContent = originalText;
            window.removeEventListener("afterprint", cleanup);
          }
          window.addEventListener("afterprint", cleanup);

          // Let layout settle before triggering print
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              window.print();
              // Fallback if afterprint doesn't fire
              setTimeout(cleanup, 4000);
            });
          });
        });
      }
    </script>

