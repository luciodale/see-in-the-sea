      }
      .pb-aside__figure img {
        width: 100%;
        height: auto;
        max-height: 70vh;
        object-fit: contain;
      }

      /* 16,18. Portfolio triptych alternating + zigzag */
      .pb-portfolio {
        padding: 140px 40px 140px;
      }
      .pb-portfolio__head {
        text-align: center;
        margin: 0 auto 96px;
