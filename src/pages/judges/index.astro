---
// Server-rendered so this is a real 301 rather than a prerendered meta-refresh
// stub, which rendered as a blank page for ~2s before bouncing.
export const prerender = false;

import { latestJudgesContestId } from '@/data/latest-judges-contest';
import type { Language } from '@/i18n/translations';
import { getLocalizedPath } from '@/i18n/utils';

const currentLang = (Astro.currentLocale ?? 'en') as Language;

return Astro.redirect(
  getLocalizedPath(`judges/${latestJudgesContestId}`, currentLang),
  301
);
---
