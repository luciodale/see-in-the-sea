---
export const prerender = true;

import JudgesPage from '@/components/pages/JudgesPage.astro';
import { pastContestsData } from '@/data/past-contests';
import type { Language } from '@/i18n/translations';
import { getLocalizedPath } from '@/i18n/utils';

export function getStaticPaths() {
  return pastContestsData.map(contest => ({
    // Both casings needed: Astro lowercases params for i18n fallback routes
    params: { contestId: contest.id, contestid: contest.id },
    props: { contestData: contest },
  }));
}

const { contestId } = Astro.params;
const { contestData } = Astro.props;
const currentLang = (Astro.currentLocale ?? 'en') as Language;

if (!contestId || !contestData) {
  return Astro.redirect(getLocalizedPath('404', currentLang));
}
---

<JudgesPage
  lang={currentLang}
  contestId={contestId}
  contestData={contestData}
/>
