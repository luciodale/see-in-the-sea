---
import TrophyPage from '@/components/pages/TrophyPage.astro';
import type { Language } from '@/i18n/translations';
import { getAlternates } from '@/i18n/utils';

const currentLang = (Astro.currentLocale ?? 'en') as Language;
const alternates = getAlternates(Astro.url);
---

<TrophyPage lang={currentLang} alternates={alternates} />
