---
import TrophyPage from '@/components/pages/TrophyPage.astro';
import { getLangFromUrl } from '@/i18n';

const currentLang = getLangFromUrl(Astro.url);
const alternates = [
  { hrefLang: 'it', href: new URL('/it/trophy', Astro.url).toString() },
  { hrefLang: 'x-default', href: Astro.url.href },
];
---

<TrophyPage lang={currentLang} alternates={alternates} />
