---
import ContestDetailPage from '@/components/pages/ContestDetailPage.astro';
import { getLangFromUrl, getLocalizedPath } from '@/i18n';

const { contestId } = Astro.params;
const currentLang = getLangFromUrl(Astro.url);

if (!contestId) {
  return Astro.redirect(getLocalizedPath('404', currentLang));
}
---

<ContestDetailPage lang={currentLang} contestId={contestId} />
