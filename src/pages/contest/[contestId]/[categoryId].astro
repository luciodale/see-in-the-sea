---
import ContestCategoryPage from '@/components/pages/ContestCategoryPage.astro';
import { getLangFromUrl, getLocalizedPath } from '@/i18n';

const { contestId, categoryId } = Astro.params;
const currentLang = getLangFromUrl(Astro.url);

if (!contestId || !categoryId) {
  return Astro.redirect(getLocalizedPath('404', currentLang));
}
---

<ContestCategoryPage
  lang={currentLang}
  contestId={contestId}
  categoryId={categoryId}
/>
