---
export const prerender = true;

import ContestCategoryPage from '@/components/pages/ContestCategoryPage.astro';
import { pastContestsData } from '@/data/past-contests';
import type { Language } from '@/i18n/translations';
import { getLocalizedPath } from '@/i18n/utils';

export function getStaticPaths() {
  return pastContestsData
    .filter(c => !c.currentContest)
    .flatMap(contest =>
      contest.categories.map(category => ({
        // Both casings needed: Astro uses camelCase for the English route
        // but lowercases directory params for the Italian fallback route
        params: {
          contestId: contest.id,
          contestid: contest.id,
          categoryId: category.id,
          categoryid: category.id,
        },
        props: {
          contestData: contest,
          contestId: contest.id,
          categoryId: category.id,
        },
      }))
    );
}

const { contestData, contestId, categoryId } = Astro.props;
const currentLang = (Astro.currentLocale ?? 'en') as Language;

if (!contestId || !categoryId) {
  return Astro.redirect(getLocalizedPath('404', currentLang));
}
---

<ContestCategoryPage
  lang={currentLang}
  contestId={contestId}
  categoryId={categoryId}
  contestData={contestData}
/>
