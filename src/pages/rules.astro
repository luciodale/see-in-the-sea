---
import RulesPage from '@/components/pages/RulesPage.astro';
import type { Language } from '@/i18n/translations';
import { getAlternates } from '@/i18n/utils';

const currentLang = (Astro.currentLocale ?? 'en') as Language;
const alternates = getAlternates(Astro.url);
---

<RulesPage lang={currentLang} alternates={alternates} />
