---
import AppWrapper from '@/components/AppWrapper.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import type { Language } from '@/i18n/translations';
import { App } from '@/react/App';
export const prerender = false;

const currentLang = (Astro.currentLocale ?? 'en') as Language;
const PUBLIC_CLERK_PUBLISHABLE_KEY = import.meta.env
  .PUBLIC_CLERK_PUBLISHABLE_KEY;
---

<AppWrapper lang={currentLang} title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <App client:only="react" clerkPublicKey={PUBLIC_CLERK_PUBLISHABLE_KEY} />
</AppWrapper>
