---
import AppHead from '../components/AppHead.astro';
import Footer from '../components/Footer.astro';

type Alternate = { hrefLang: string; href: string };

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: string;
  twitterCard?: 'summary' | 'summary_large_image' | 'app' | 'player';
  bodyClass?: string;
  lang?: string;
  alternates?: Alternate[];
  keywords?: string[];
  additionalJsonLd?: unknown[];
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  ogType = 'website',
  twitterCard = 'summary_large_image',
  bodyClass = 'min-h-screen bg-background text-foreground flex flex-col',
  lang,
  alternates = [],
  keywords,
  additionalJsonLd,
} = Astro.props;

const currentUrl = Astro.url.href;
const currentLang = (lang || Astro.currentLocale || 'en') as 'en' | 'it';
---

<!doctype html>
<html lang={currentLang} class="dark">
  <head>
    <AppHead
      title={title}
      description={description}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogType={ogType}
      twitterCard={twitterCard}
      canonicalUrl={currentUrl}
      siteName="See in the Sea"
      locale={currentLang === 'it' ? 'it_IT' : 'en_GB'}
      alternates={alternates}
      keywords={keywords}
      additionalJsonLd={additionalJsonLd}
    />
  </head>
  <body class={bodyClass}>
    <div class="flex-1">
      <slot />
    </div>
    <Footer lang={currentLang} />
  </body>
</html>
