---
import type { Language } from '@/i18n/translations';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);

const allPartners = [
  // Patrocini
  {
    src: '/images/patrocini/regione-abruzzo-logo.svg',
    alt: 'Regione Abruzzo',
    prominent: true,
  },
  { src: '/images/patrocini/one-ocean-young-logo.svg', alt: 'One Ocean Young' },
  {
    src: '/images/patrocini/ortona-logo.png',
    alt: 'Comune di Ortona',
    prominent: true,
  },
  { src: '/images/patrocini/arpa-abruzzo-logo.svg', alt: 'ARPA Abruzzo' },
  // Collaborations
  { src: '/images/collabs/zeropixel-logo.png', alt: 'Zeropixel' },
  { src: '/images/collabs/scubaportal-logo.png', alt: 'Scubaportal' },
];

const label =
  lang === 'it' ? 'Patrocini e Collaborazioni' : 'Partners & Collaborations';
---

<section class="bg-background border-t border-border py-16 px-4">
  <div class="max-w-5xl mx-auto space-y-10">
    <p
      class="text-center text-editorial uppercase tracking-editorial-wider text-muted-foreground"
    >
      {label}
    </p>
    <div
      class="flex items-center justify-center gap-10 sm:gap-14 flex-wrap"
    >
      {
        allPartners.map(p => (
          <img
            src={p.src}
            alt={p.alt}
            loading="lazy"
            class:list={[
              'w-auto opacity-70 hover:opacity-100 transition-opacity duration-300',
              p.prominent ? 'h-12 sm:h-14' : 'h-8 sm:h-10',
            ]}
          />
        ))
      }
    </div>
  </div>
</section>
