---
import { Picture } from 'astro:assets';

type Props = {
  title: string;
  description: string;
  image: { link: string; objectFit?: boolean };

  isRight?: boolean;
  buttonCTA?: {
    text: string;
    link: string;
    target?: string;
  };
};

const { title, description, image, isRight = false, buttonCTA } = Astro.props;

const objectFit = image.objectFit ?? false;
---

<div class="flex items-center justify-center">
  <div
    class="max-w-2xl lg:max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center"
  >
    <!-- Text Content -->
    <div class={`space-y-8 ${isRight ? 'lg:order-2' : 'lg:order-1'}`}>
      <div class="space-y-6">
        <h2
          class="font-serif text-4xl sm:text-5xl md:text-6xl text-foreground leading-display tracking-display"
        >
          {title}
        </h2>
        <p
          class="text-sm sm:text-base font-light text-muted-foreground leading-paragraph max-w-prose-narrow"
        >
          {description}
        </p>
      </div>

      {
        buttonCTA && (
          <div class="pt-2">
            <a
              href={buttonCTA.link}
              class="inline-flex items-center px-5 py-2 bg-surface border border-border text-foreground rounded-full transition-all duration-300 text-editorial uppercase tracking-editorial hover:bg-surface-hover hover:border-border-strong"
              target={buttonCTA.target}
            >
              {buttonCTA.text}
            </a>
          </div>
        )
      }
    </div>

    <!-- Image -->
    <div class={`${isRight ? 'lg:order-1' : 'lg:order-2'}`}>
      <div class="aspect-square overflow-hidden bg-surface rounded-lg">
        <Picture
          src={image.link}
          alt={title}
          class={`w-full h-full ${objectFit ? 'object-cover' : ''}`}
          width={1000}
          height={1000}
        />
      </div>
    </div>
  </div>
</div>
