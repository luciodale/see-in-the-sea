---
type Alternate = { hrefLang: string; href: string };

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: string;
  twitterCard?: 'summary' | 'summary_large_image' | 'app' | 'player';
  canonicalUrl?: string;
  siteName?: string;
  locale?: string;
  alternates?: Alternate[];
  keywords?: string[];
  additionalJsonLd?: unknown[];
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  ogImageWidth = 2000,
  ogImageHeight = 1333,
  ogType = 'website',
  twitterCard = 'summary_large_image',
  canonicalUrl = Astro.url.href,
  siteName = 'See in the Sea',
  locale,
  alternates = [],
  keywords,
  additionalJsonLd = [],
} = Astro.props;

import '../styles/global.css';

const resolvedOgImage = ogImage
  ? new URL(ogImage, canonicalUrl).toString()
  : new URL('/images/wallpaper.webp', canonicalUrl).toString();

const resolvedOgImageAlt =
  ogImageAlt ??
  'Underwater photograph from the See in the Sea international contest';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: new URL('/', canonicalUrl).toString(),
  inLanguage: locale?.split('_')[0] || 'en',
};

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: new URL('/', canonicalUrl).toString(),
  logo: new URL('/images/logo.svg', canonicalUrl).toString(),
  sameAs: [
    'https://www.facebook.com/seeintheseauw',
    'https://www.instagram.com/seeinthesea_uw/',
  ],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      email: 'info@ortonasub.com',
      contactType: 'customer service',
      availableLanguage: ['en', 'it'],
    },
  ],
};

const baseLd = [websiteLd, organizationLd, ...additionalJsonLd];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
{keywords && keywords.length > 0 && (
  <meta name="keywords" content={keywords.join(', ')} />
)}
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="theme-color" content="#000000" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
  rel="stylesheet"
/>

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteName} />
{locale && <meta property="og:locale" content={locale} />}
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:alt" content={resolvedOgImageAlt} />

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />
<meta name="twitter:image:alt" content={resolvedOgImageAlt} />

{
  alternates.map(alt => (
    <link rel="alternate" hreflang={alt.hrefLang} href={alt.href} />
  ))
}

{
  baseLd.map(ld => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))
}
