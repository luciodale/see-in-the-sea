---
import { useTranslations, type Language } from '@/i18n';

type PortfolioImage = {
  imageUrl: string;
  fullImageUrl: string;
  title: string;
};

type Props = {
  categoryName: string;
  rank: string;
  rawResult: string; // 'first', 'second', 'third', 'runner-up'
  author: string;
  images: PortfolioImage[];
};

const { categoryName, rank, rawResult, author, images }: Props = Astro.props;

const currentLang = (Astro.currentLocale ?? 'en') as Language;
const t = useTranslations(currentLang);

const getAccentStyles = (result: string) => {
  switch (result) {
    case 'first':
      return {
        border: 'border-amber-400/30',
        badge: 'bg-gradient-to-r from-amber-500 to-yellow-500',
      };
    case 'second':
      return {
        border: 'border-slate-400/30',
        badge: 'bg-gradient-to-r from-slate-400 to-gray-400',
      };
    case 'third':
      return {
        border: 'border-orange-600/30',
        badge: 'bg-gradient-to-r from-orange-600 to-amber-600',
      };
    default:
      return {
        border: 'border-cyan-500/30',
        badge: 'bg-gradient-to-r from-cyan-500 to-blue-500',
      };
  }
};

const styles = getAccentStyles(rawResult);
---

<div class="portfolio-section">
  <div
    class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-4"
  >
    <div class="space-y-1.5">
      <span
        class={`inline-block px-2.5 py-1 text-[10px] font-semibold uppercase tracking-widest ${styles.badge} text-white rounded-full shadow-lg`}
      >
        {rank}
      </span>
      <h2
        class="text-xl sm:text-2xl md:text-3xl font-light text-white tracking-wide"
      >
        {categoryName}
      </h2>
    </div>
    <div class="sm:text-right space-y-0.5">
      <p class="text-base sm:text-lg font-light text-white/90">{author}</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {
      images.map((image, index) => (
        <div
          class="portfolio-image-wrapper group"
          data-image-url={image.imageUrl}
        >
          <div
            class={`relative aspect-[4/3] rounded-xl overflow-hidden shadow-lg border ${styles.border} bg-slate-900 cursor-pointer outline-none focus:outline-none hover:border-opacity-60 transition-all duration-300`}
            role="button"
            tabindex="0"
            data-lightbox-trigger
            data-lightbox-src={image.fullImageUrl}
            data-lightbox-title={image.title || `${categoryName} - ${index + 1}`}
            data-lightbox-author={author}
          >
            <div class="portfolio-skeleton absolute inset-0 animate-pulse bg-gradient-to-br from-slate-800 via-slate-850 to-slate-900 flex items-center justify-center">
              <svg
                class="w-10 h-10 text-slate-700"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                />
              </svg>
            </div>

            <div class="portfolio-fallback absolute inset-0 hidden items-center justify-center bg-gradient-to-br from-slate-800 to-slate-900">
              <div class="flex flex-col items-center gap-1.5 text-gray-400">
                <svg
                  class="w-8 h-8"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                  />
                </svg>
                <span class="text-xs">{t('image.click-to-view')}</span>
              </div>
            </div>

            <img
              class="portfolio-image absolute inset-0 w-full h-full object-cover opacity-0 transition-all duration-500 group-hover:scale-105"
              data-src={image.imageUrl}
              alt={image.title || `${categoryName} - ${index + 1}`}
              loading="lazy"
            />

            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
            <div class="absolute bottom-0 left-0 right-0 p-3 translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
              {image.title && (
                <p class="text-white text-sm font-light italic truncate">
                  {image.title}
                </p>
              )}
            </div>
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
              <div class="bg-black/50 backdrop-blur-sm rounded-full p-2">
                <svg
                  class="w-5 h-5 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"
                  />
                </svg>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  const observerOptions = {
    root: null,
    rootMargin: '200px',
    threshold: 0.01,
  };

  const portfolioObserver = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const wrapper = entry.target as HTMLElement;
        const img = wrapper.querySelector(
          '.portfolio-image'
        ) as HTMLImageElement;
        const skeleton = wrapper.querySelector(
          '.portfolio-skeleton'
        ) as HTMLElement;
        const fallback = wrapper.querySelector(
          '.portfolio-fallback'
        ) as HTMLElement;
        const imageUrl = img?.dataset.src;

        if (img && imageUrl) {
          img.src = imageUrl;
          img.onload = () => {
            img.classList.remove('opacity-0');
            img.classList.add('opacity-100');
            skeleton?.classList.add('hidden');
          };
          img.onerror = () => {
            skeleton?.classList.add('hidden');
            fallback?.classList.remove('hidden');
            fallback?.classList.add('flex');
          };
        }
        observer.unobserve(wrapper);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.portfolio-image-wrapper').forEach(wrapper => {
    portfolioObserver.observe(wrapper);
  });
</script>
