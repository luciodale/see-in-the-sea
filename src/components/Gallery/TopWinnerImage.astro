---
import { getLangFromUrl, useTranslations } from '@/i18n';
import { getRankColorClass } from '@/utils/rankUtils';
import BaseImage from './BaseImage.astro';

type Props = {
  categoryName: string;
  rank: string;
  rawResult: string; // 'first', 'second', 'third'
  imageUrl: string;
  title: string;
  author: string;
};

const { imageUrl, title, author, categoryName, rank, rawResult }: Props =
  Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const rankColorClass = getRankColorClass(rawResult);
---

<div class="space-y-6 md:space-y-8">
  <h2
    class="flex flex-col md:flex-row md:gap-10 gap-2 text-pretty justify-between items-baseline text-gray-100 uppercase"
  >
    <div>
      <p class="text-2xl md:text-3xl md:text-left font-extralight">
        {categoryName}
      </p>
      <p class={`text-xl md:text-2xl font-thin italic ${rankColorClass}`}>
        {rank}
      </p>
    </div>
    <div>
      <p class="text-2xl md:text-3xl md:text-right font-thin">
        {author}
      </p>
      <p class="text-xl md:text-2xl md:text-right font-thin italic">
        {title}
      </p>
    </div>
  </h2>
  <div class="gap-8">
    <BaseImage
      imageUrl={imageUrl}
      title={title}
      author={author}
      showInfo={false}
    />
  </div>
</div>
