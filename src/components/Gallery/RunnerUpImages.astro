---
import { getLangFromUrl, getResultName } from '@/i18n';
import BaseImage from './BaseImage.astro';

type Props = {
  runnerUps: {
    result: string;
    imageUrl: string;
    title: string;
    author: string;
    categoryName: string;
  }[];
};

const { runnerUps }: Props = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
---

{
  runnerUps.length > 0 && (
    <div class="space-y-12">
      <!-- Glass Title Card -->
      <div class="backdrop-blur-lg bg-gradient-to-br from-white/10 via-purple-500/5 to-transparent rounded-2xl border border-white/20 p-6 shadow-2xl">
        <h2 class="text-3xl md:text-4xl font-light text-white uppercase text-center tracking-wider drop-shadow-lg">
          {getResultName('Runner Ups', currentLang)}
        </h2>
      </div>

      <!-- Masonry Grid -->
      <div class="columns-1 md:columns-2 gap-6 md:gap-8 space-y-6 md:space-y-8">
        {runnerUps.map(runnerUp => (
          <div class="break-inside-avoid mb-6 md:mb-8">
            <div class="rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl hover:shadow-purple-500/10 transition-all duration-500">
              <BaseImage
                imageUrl={runnerUp.imageUrl}
                title={runnerUp.title}
                author={runnerUp.author}
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  )
}
