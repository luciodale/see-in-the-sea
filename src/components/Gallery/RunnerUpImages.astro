---
import { getLangFromUrl, getResultName } from '@/i18n';

type Props = {
  runnerUps: {
    result: string;
    imageUrl: string;
    fullImageUrl: string;
    title: string;
    author: string;
    categoryName: string;
  }[];
};

const { runnerUps }: Props = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
---

{
  runnerUps.length > 0 && (
    <div class="space-y-8">
      <div class="flex items-center gap-4">
        <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-widest bg-gradient-to-r from-blue-500 to-cyan-500 text-white rounded-full shadow-lg">
          {getResultName('Runner Ups', currentLang)}
        </span>
        <div class="flex-1 h-px bg-gradient-to-r from-blue-500/30 to-transparent" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {runnerUps.map(runnerUp => (
          <div
            class="runnerup-section group"
            data-image-url={runnerUp.imageUrl}
          >
            <div
              class="relative aspect-[4/3] rounded-xl overflow-hidden shadow-lg border border-slate-700/50 bg-slate-900 hover:border-cyan-500/30 transition-all duration-300 cursor-pointer outline-none focus:outline-none"
              role="button"
              tabindex="0"
              data-lightbox-trigger
              data-lightbox-src={runnerUp.fullImageUrl}
              data-lightbox-title={runnerUp.title || 'Runner up'}
              data-lightbox-author={runnerUp.author}
            >
              <div class="runnerup-skeleton absolute inset-0 animate-pulse bg-gradient-to-br from-slate-800 to-slate-900 flex items-center justify-center">
                <svg
                  class="w-10 h-10 text-slate-700"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1"
                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                  />
                </svg>
              </div>
              <img
                class="runnerup-image absolute inset-0 w-full h-full object-cover opacity-0 transition-all duration-500 group-hover:scale-105"
                data-src={runnerUp.imageUrl}
                alt={runnerUp.title || 'Runner up'}
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
              <div class="absolute bottom-0 left-0 right-0 p-4 translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                <p class="text-white font-light text-sm">{runnerUp.author}</p>
                {runnerUp.title && (
                  <p class="text-gray-300 text-xs italic mt-0.5">
                    {runnerUp.title}
                  </p>
                )}
              </div>
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
                <div class="bg-black/50 backdrop-blur-sm rounded-full p-2">
                  <svg
                    class="w-5 h-5 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"
                    />
                  </svg>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  )
}

<script>
  // Intersection Observer for lazy loading runner-up images
  const observerOptions = {
    root: null,
    rootMargin: '200px',
    threshold: 0.01,
  };

  const runnerUpObserver = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const section = entry.target as HTMLElement;
        const img = section.querySelector(
          '.runnerup-image'
        ) as HTMLImageElement;
        const skeleton = section.querySelector(
          '.runnerup-skeleton'
        ) as HTMLElement;
        const imageUrl = img?.dataset.src;

        if (img && imageUrl) {
          img.src = imageUrl;
          img.onload = () => {
            img.classList.remove('opacity-0');
            img.classList.add('opacity-100');
            if (skeleton) {
              skeleton.classList.add('hidden');
            }
          };
          img.onerror = () => {
            if (skeleton) {
              skeleton.innerHTML = `
                <div class="flex flex-col items-center gap-1.5 text-red-400">
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                  <span class="text-xs">Errore</span>
                </div>
              `;
              skeleton.classList.remove('animate-pulse');
            }
          };
        }
        observer.unobserve(section);
      }
    });
  }, observerOptions);

  // Observe all runner-up sections
  document.querySelectorAll('.runnerup-section').forEach(section => {
    runnerUpObserver.observe(section);
  });
</script>
