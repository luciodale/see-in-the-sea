---
import type { Language } from '@/i18n/translations';
import { getResultName, useTranslations } from '@/i18n/utils';

type Props = {
  runnerUps: {
    result: string;
    imageUrl: string;
    fullImageUrl: string;
    title: string;
    author: string;
    categoryName: string;
  }[];
};

const { runnerUps }: Props = Astro.props;
const currentLang = (Astro.currentLocale ?? 'en') as Language;
const t = useTranslations(currentLang);
const clickToViewText = t('image.click-to-view');
---

{
  runnerUps.length > 0 && (
    <div class="space-y-8">
      <div class="flex items-center gap-4">
        <span class="inline-block px-3 py-1 text-editorial uppercase tracking-editorial-wide bg-accent text-accent-foreground rounded-full">
          {getResultName('Runner Ups', currentLang)}
        </span>
        <div class="flex-1 h-px bg-gradient-to-r from-border-strong to-transparent" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {runnerUps.map(runnerUp => (
          <div
            class="runnerup-section group"
            data-image-url={runnerUp.imageUrl}
          >
            <div
              class="relative aspect-[4/3] rounded-xl overflow-hidden shadow-lg border border-border bg-background hover:border-accent/40 transition-all duration-300 cursor-pointer outline-none focus:outline-none"
              role="button"
              tabindex="0"
              data-lightbox-trigger
              data-lightbox-src={runnerUp.fullImageUrl}
              data-lightbox-title={runnerUp.title || 'Runner up'}
              data-lightbox-author={runnerUp.author}
            >
              <div class="runnerup-skeleton absolute inset-0 animate-pulse bg-surface flex items-center justify-center">
                <svg
                  class="w-10 h-10 text-subtle-foreground"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1"
                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                  />
                </svg>
              </div>

              <div
                class="runnerup-fallback absolute inset-0 hidden items-center justify-center bg-surface"
                data-fallback-text={clickToViewText}
              >
                <div class="flex flex-col items-center gap-1.5 text-muted-foreground">
                  <svg
                    class="w-8 h-8"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                    />
                  </svg>
                  <span class="text-xs fallback-text">{clickToViewText}</span>
                </div>
              </div>

              <img
                class="runnerup-image absolute inset-0 w-full h-full object-cover opacity-0 transition-all duration-500 group-hover:scale-105"
                data-src={runnerUp.imageUrl}
                alt={`${runnerUp.title || runnerUp.categoryName} - ${runnerUp.categoryName} runner up by ${runnerUp.author}, See in the Sea underwater photography contest`}
                loading="lazy"
              />

              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
              <div class="absolute bottom-0 left-0 right-0 p-4 translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                <p class="font-serif text-foreground text-base leading-tight">{runnerUp.author}</p>
                {runnerUp.title && (
                  <p class="text-muted-foreground text-xs italic mt-0.5">
                    {runnerUp.title}
                  </p>
                )}
              </div>
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
                <div class="bg-black/50 backdrop-blur-sm rounded-full p-2">
                  <svg
                    class="w-5 h-5 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"
                    />
                  </svg>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  )
}

<script>
  const observerOptions = {
    root: null,
    rootMargin: '200px',
    threshold: 0.01,
  };

  const runnerUpObserver = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const section = entry.target as HTMLElement;
        const img = section.querySelector(
          '.runnerup-image'
        ) as HTMLImageElement;
        const skeleton = section.querySelector(
          '.runnerup-skeleton'
        ) as HTMLElement;
        const fallback = section.querySelector(
          '.runnerup-fallback'
        ) as HTMLElement;
        const imageUrl = img?.dataset.src;

        if (img && imageUrl) {
          img.src = imageUrl;
          img.onload = () => {
            img.classList.remove('opacity-0');
            img.classList.add('opacity-100');
            skeleton?.classList.add('hidden');
          };
          img.onerror = () => {
            skeleton?.classList.add('hidden');
            fallback?.classList.remove('hidden');
            fallback?.classList.add('flex');
          };
        }
        observer.unobserve(section);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.runnerup-section').forEach(section => {
    runnerUpObserver.observe(section);
  });
</script>
