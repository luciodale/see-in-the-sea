---
import type { Contest } from '@/data/past-contests';
import {
  getCategoryName,
  getLangFromUrl,
  getResultName,
  useTranslations,
} from '@/i18n';
import { getFullQualityImageUrl } from '../../server/imageService';
import GalleryInfo from './GalleryInfo.astro';
import TopWinnerImage from './TopWinnerImage.astro';

type Props = {
  contestId: string;
  contestData: Contest;
};

const { contestId, contestData } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// Get first place winners from contestData
const firstPlaceWinners = contestData.categories.flatMap(category =>
  category.entries
    .filter(entry => entry.placement === 'first')
    .map(entry => ({
      entry,
      category,
    }))
);

// Process images - filter out winners without valid images
const processedImages = firstPlaceWinners
  .map(({ entry, category }) => {
    const translatedCategoryName = getCategoryName(
      category.id,
      category.name,
      currentLang
    );

    const imageUrl = entry.image;
    const fullImageUrl = getFullQualityImageUrl(entry.imageR2Id);

    return {
      imageUrl,
      fullImageUrl,
      categoryName: translatedCategoryName,
      title: entry.title,
      author:
        entry.photographer.firstName && entry.photographer.lastName
          ? `${entry.photographer.firstName} ${entry.photographer.lastName}`
          : t('author.anonymous'),
      result: entry.placement,
    };
  })
  .filter(
    (w): w is typeof w & { imageUrl: string; fullImageUrl: string } =>
      w.imageUrl !== null && w.fullImageUrl !== null
  );
---

<GalleryInfo
  contestTitle={contestData.name}
  contestId={contestId}
  contestData={contestData}
/>

<div class="mt-10 sm:mt-12">
  {
    processedImages.length > 0 ? (
      <div class="space-y-12 sm:space-y-16 md:space-y-20">
        {processedImages.map((winner, index) => (
          <div
            class="winner-entry"
            style={`animation-delay: ${index * 100}ms;`}
          >
            <TopWinnerImage
              categoryName={winner.categoryName}
              rank={getResultName('First Place', currentLang)}
              rawResult={winner.result}
              imageUrl={winner.imageUrl}
              fullImageUrl={winner.fullImageUrl}
              title={winner.title}
              author={winner.author}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <div class="inline-flex flex-col items-center gap-4 p-8 rounded-2xl backdrop-blur-xl bg-white/5 border border-white/10">
          <div class="text-5xl">🏆</div>
          <div class="space-y-2">
            <h3 class="text-xl font-light text-white">
              {t('contests.no-winners')}
            </h3>
            <p class="text-gray-400 text-sm max-w-sm">
              {t('contests.no-winners-desc')}
            </p>
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .winner-entry {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(30px);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
