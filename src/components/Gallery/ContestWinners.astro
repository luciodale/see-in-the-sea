---
import type { Contest, Entry } from '@/data/past-contests';
import {
  getCategoryName,
  getResultName,
  type Language,
  useTranslations,
} from '@/i18n';
import { MEDITERRANEAN_CATEGORY_ID } from '../../constants';
import { getFullQualityImageUrl } from '../../server/imageService';
import GalleryInfo from './GalleryInfo.astro';
import MediterraneanPortfolioWinner from './MediterraneanPortfolioWinner.astro';
import TopWinnerImage from './TopWinnerImage.astro';

type Props = {
  contestId: string;
  contestData: Contest;
};

const { contestId, contestData } = Astro.props;
const currentLang = (Astro.currentLocale ?? 'en') as Language;
const t = useTranslations(currentLang);

const getAuthorName = (entry: Entry) =>
  entry.photographer.firstName && entry.photographer.lastName
    ? `${entry.photographer.firstName} ${entry.photographer.lastName}`
    : t('author.anonymous');

const getPhotographerKey = (entry: Entry) =>
  `${entry.photographer.firstName}-${entry.photographer.lastName}`;

// Separate Mediterranean from other categories
const mediterraneanCategory = contestData.categories.find(
  c => c.id === MEDITERRANEAN_CATEGORY_ID
);
const categoryOrder: Record<string, number> = {
  macro: 0,
  'wide-angle': 1,
  'black-and-white': 2,
};
const otherCategories = contestData.categories
  .filter(c => c.id !== MEDITERRANEAN_CATEGORY_ID)
  .sort((a, b) => (categoryOrder[a.id] ?? 99) - (categoryOrder[b.id] ?? 99));

// Process Mediterranean first-place portfolios (grouped by photographer)
const mediterraneanPortfolios = (() => {
  if (!mediterraneanCategory) return [];

  const firstPlaceEntries = mediterraneanCategory.entries.filter(
    e => e.placement === 'first'
  );
  const groups = new Map<string, Entry[]>();

  firstPlaceEntries.forEach(entry => {
    const key = getPhotographerKey(entry);
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key)?.push(entry);
  });

  return Array.from(groups.values()).map(entries => ({
    categoryName: getCategoryName(
      mediterraneanCategory.id,
      mediterraneanCategory.name,
      currentLang
    ),
    author: getAuthorName(entries[0]),
    result: 'first' as const,
    images: entries
      .map(entry => ({
        imageUrl: entry.image,
        fullImageUrl: getFullQualityImageUrl(entry.imageR2Id),
        title: entry.title,
      }))
      .filter(
        (img): img is typeof img & { imageUrl: string; fullImageUrl: string } =>
          img.imageUrl !== null && img.fullImageUrl !== null
      ),
  }));
})();

// Process regular first-place winners
const regularWinners = otherCategories
  .flatMap(category =>
    category.entries
      .filter(entry => entry.placement === 'first')
      .map(entry => ({
        entry,
        category,
      }))
  )
  .map(({ entry, category }) => ({
    imageUrl: entry.image,
    fullImageUrl: getFullQualityImageUrl(entry.imageR2Id),
    categoryName: getCategoryName(category.id, category.name, currentLang),
    title: entry.title,
    author: getAuthorName(entry),
    result: entry.placement,
  }))
  .filter(
    (w): w is typeof w & { imageUrl: string; fullImageUrl: string } =>
      w.imageUrl !== null && w.fullImageUrl !== null
  );

const hasWinners =
  regularWinners.length > 0 || mediterraneanPortfolios.length > 0;
---

<GalleryInfo
  contestTitle={contestData.name}
  contestId={contestId}
  contestData={contestData}
/>

<div class="mt-10 sm:mt-12">
  {
    hasWinners ? (
      <div class="space-y-12 sm:space-y-16 md:space-y-20">
        {regularWinners.map((winner, index) => (
          <div
            class="winner-entry"
            style={`animation-delay: ${index * 100}ms;`}
          >
            <TopWinnerImage
              categoryName={winner.categoryName}
              rank={getResultName('First Place', currentLang)}
              rawResult={winner.result}
              imageUrl={winner.imageUrl}
              fullImageUrl={winner.fullImageUrl}
              title={winner.title}
              author={winner.author}
            />
          </div>
        ))}
        {mediterraneanPortfolios.map((portfolio, index) => (
          <div
            class="winner-entry"
            style={`animation-delay: ${(regularWinners.length + index) * 100}ms;`}
          >
            <MediterraneanPortfolioWinner
              categoryName={portfolio.categoryName}
              rank={getResultName('First Place', currentLang)}
              rawResult={portfolio.result}
              author={portfolio.author}
              images={portfolio.images}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <div class="inline-flex flex-col items-center gap-4 p-8 rounded-2xl backdrop-blur-xl bg-white/5 border border-white/10">
          <div class="text-5xl">🏆</div>
          <div class="space-y-2">
            <h3 class="text-xl font-light text-white">
              {t('contests.no-winners')}
            </h3>
            <p class="text-gray-400 text-sm max-w-sm">
              {t('contests.no-winners-desc')}
            </p>
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .winner-entry {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(30px);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
