---
import { IMAGES_BASE_URL } from '@/constants';
import { type Contest, pastContestsData } from '@/data/past-contests';
import type { Language } from '@/i18n/translations';
import { getLocalizedPath, useTranslations } from '@/i18n/utils';

type Props = {
  contestId: string;
  contestData: Contest;
};

const { contestId, contestData } = Astro.props;
const currentLang = (Astro.currentLocale ?? 'en') as Language;
const t = useTranslations(currentLang);

const contestJudges = contestData.judges;

// Year navigation (same logic as GalleryInfo)
const sortedContests = pastContestsData
  .map(c => ({ id: c.id, name: c.name, year: c.year }))
  .sort((a, b) => b.year - a.year);
const currentIndex = sortedContests.findIndex(c => c.id === contestId);
const prevContest =
  currentIndex < sortedContests.length - 1
    ? sortedContests[currentIndex + 1]
    : null;
const nextContest = currentIndex > 0 ? sortedContests[currentIndex - 1] : null;
---

<div class="space-y-6 pb-6">
  <!-- Year Navigation Pills -->
  <div class="hidden sm:flex justify-center">
    <div
      class="flex items-center gap-1 p-1 backdrop-blur-xl bg-white/5 rounded-full border border-white/10"
    >
      {
        sortedContests.map(contest => {
          const isActive = contest.id === contestId;
          return (
            <a
              href={getLocalizedPath(`judges/${contest.id}`, currentLang)}
              class:list={[
                'px-3 py-1.5 rounded-full text-xs font-medium transition-all duration-300 whitespace-nowrap',
                isActive
                  ? 'bg-gradient-to-r from-cyan-500 to-blue-500 text-white shadow-lg shadow-cyan-500/30'
                  : 'text-gray-400 hover:text-white hover:bg-white/10',
              ]}
            >
              {contest.year}
            </a>
          );
        })
      }
    </div>
  </div>

  <!-- Title with arrow navigation -->
  <div class="text-center space-y-4">
    <div class="flex items-center justify-center gap-4">
      {
        nextContest ? (
          <a
            href={getLocalizedPath(`judges/${nextContest.id}`, currentLang)}
            class="group flex items-center gap-1 text-gray-500 hover:text-cyan-400 transition-colors duration-300"
            title={`${nextContest.year}`}
          >
            <svg
              class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform duration-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"
              />
            </svg>
            <span class="text-xs font-light">{nextContest.year}</span>
          </a>
        ) : (
          <div class="w-8 sm:w-12" />
        )
      }

      <h1
        class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-light text-white uppercase tracking-[0.05em] sm:tracking-[0.1em]"
      >
        {t('judges.page-title')} {contestData.year}
      </h1>

      {
        prevContest ? (
          <a
            href={getLocalizedPath(`judges/${prevContest.id}`, currentLang)}
            class="group flex items-center gap-1 text-gray-500 hover:text-cyan-400 transition-colors duration-300"
            title={`${prevContest.year}`}
          >
            <span class="text-xs font-light">{prevContest.year}</span>
            <svg
              class="w-5 h-5 transform group-hover:translate-x-1 transition-transform duration-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>
        ) : (
          <div class="w-8 sm:w-12" />
        )
      }
    </div>
  </div>
</div>

<!-- Judges Cards -->
<div class="mt-10 sm:mt-12">
  {
    contestJudges.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-4xl mx-auto">
        {contestJudges.map((judge, index) => (
          <div
            class="judge-entry flex flex-col items-center text-center"
            style={`animation-delay: ${index * 150}ms;`}
          >
            <div class="relative group">
              {judge.r2ImageId ? (
                <img
                  src={`${IMAGES_BASE_URL}/${judge.r2ImageId}`}
                  alt={judge.fullName}
                  loading="lazy"
                  class="w-40 h-40 sm:w-48 sm:h-48 rounded-full object-cover border-2 border-cyan-500/30 shadow-xl shadow-cyan-500/10 transition-all duration-500 group-hover:border-cyan-400/60 group-hover:shadow-cyan-500/20"
                />
              ) : (
                <div class="w-40 h-40 sm:w-48 sm:h-48 rounded-full bg-gradient-to-br from-slate-700 to-slate-800 border-2 border-white/10 shadow-xl flex items-center justify-center transition-all duration-500 group-hover:border-cyan-500/30">
                  <svg
                    class="w-16 h-16 text-slate-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                    />
                  </svg>
                </div>
              )}
            </div>
            <h3 class="mt-4 text-lg sm:text-xl font-light text-white tracking-wide">
              {judge.fullName}
            </h3>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <div class="inline-flex flex-col items-center gap-4 p-8 rounded-2xl backdrop-blur-xl bg-white/5 border border-white/10">
          <div class="space-y-2">
            <h3 class="text-xl font-light text-white">
              {t('judges.title')}
            </h3>
            <p class="text-gray-400 text-sm max-w-sm">
              {t('contests.no-winners-desc')}
            </p>
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .judge-entry {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(30px);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
