---
import { IMAGES_BASE_URL } from '@/constants';
import { type Contest, pastContestsData } from '@/data/past-contests';
import type { Language } from '@/i18n/translations';
import { getLocalizedPath, useTranslations } from '@/i18n/utils';

type Props = {
  contestId: string;
  contestData: Contest;
};

const { contestId, contestData } = Astro.props;
const currentLang = (Astro.currentLocale ?? 'en') as Language;
const t = useTranslations(currentLang);

const contestJudges = contestData.judges;

// Year navigation (same logic as GalleryInfo)
const sortedContests = pastContestsData
  .map(c => ({ id: c.id, name: c.name, year: c.year }))
  .sort((a, b) => b.year - a.year);
const currentIndex = sortedContests.findIndex(c => c.id === contestId);
const prevContest =
  currentIndex < sortedContests.length - 1
    ? sortedContests[currentIndex + 1]
    : null;
const nextContest = currentIndex > 0 ? sortedContests[currentIndex - 1] : null;
---

<header class="space-y-12 sm:space-y-14 pb-12">
  <!-- Years timeline - minimal editorial (desktop only) -->
  <div
    class="hidden sm:flex flex-wrap justify-center items-center gap-x-3 gap-y-3 text-editorial uppercase tracking-editorial-wider"
  >
    {
      sortedContests.map((contest, idx) => {
        const isActive = contest.id === contestId;
        return (
          <>
            {idx > 0 && (
              <span
                class="inline-block w-1 h-1 rounded-full bg-muted-foreground/60"
                aria-hidden="true"
              />
            )}
            <a
              href={getLocalizedPath(`judges/${contest.id}`, currentLang)}
              class:list={[
                'transition-colors duration-300',
                isActive
                  ? 'text-foreground'
                  : 'text-muted-foreground hover:text-foreground',
              ]}
            >
              {contest.year}
            </a>
          </>
        );
      })
    }
  </div>

  <!-- Title with inline prev/next navigation -->
  <div class="flex items-center justify-center gap-4 sm:gap-8">
    {
      nextContest ? (
        <a
          href={getLocalizedPath(`judges/${nextContest.id}`, currentLang)}
          class="group flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors duration-300 text-editorial uppercase tracking-editorial flex-shrink-0"
          title={`${nextContest.year}`}
          aria-label={`Previous contest: ${nextContest.year}`}
        >
          <svg
            class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M15 19l-7-7 7-7"
            />
          </svg>
          <span class="hidden md:inline">{nextContest.year}</span>
        </a>
      ) : (
        <span class="w-5 md:w-16 flex-shrink-0" aria-hidden="true" />
      )
    }

    <h1
      class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-foreground leading-display-tight tracking-display text-center"
    >
      {t('judges.page-title')} {contestData.year}
    </h1>

    {
      prevContest ? (
        <a
          href={getLocalizedPath(`judges/${prevContest.id}`, currentLang)}
          class="group flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors duration-300 text-editorial uppercase tracking-editorial flex-shrink-0"
          title={`${prevContest.year}`}
          aria-label={`Next contest: ${prevContest.year}`}
        >
          <span class="hidden md:inline">{prevContest.year}</span>
          <svg
            class="w-5 h-5 transform group-hover:translate-x-1 transition-transform duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </a>
      ) : (
        <span class="w-5 md:w-16 flex-shrink-0" aria-hidden="true" />
      )
    }
  </div>
</header>

<!-- Judges Cards -->
<div class="mt-10 sm:mt-12">
  {
    contestJudges.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-4xl mx-auto">
        {contestJudges.map((judge, index) => (
          <div
            class="judge-entry flex flex-col items-center text-center"
            style={`animation-delay: ${index * 150}ms;`}
          >
            <div class="relative group">
              {judge.r2ImageId ? (
                <img
                  src={`${IMAGES_BASE_URL}/${judge.r2ImageId}`}
                  alt={judge.fullName}
                  loading="lazy"
                  class="w-40 h-40 sm:w-48 sm:h-48 rounded-full object-cover border-2 border-accent/40 shadow-xl shadow-black/30 transition-all duration-500 group-hover:border-accent-hover group-hover:shadow-black/40"
                />
              ) : (
                <div class="w-40 h-40 sm:w-48 sm:h-48 rounded-full bg-surface-raised border-2 border-border shadow-xl flex items-center justify-center transition-all duration-500 group-hover:border-accent/40">
                  <svg
                    class="w-16 h-16 text-subtle-foreground"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                    />
                  </svg>
                </div>
              )}
            </div>
            <h3 class="mt-4 font-serif text-xl sm:text-2xl text-foreground leading-tight">
              {judge.fullName}
            </h3>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <div class="inline-flex flex-col items-center gap-4 p-8 rounded-2xl backdrop-blur-xl bg-surface/60 border border-border">
          <div class="space-y-2">
            <h3 class="font-serif text-2xl text-foreground leading-tight">
              {t('judges.title')}
            </h3>
            <p class="text-muted-foreground text-sm leading-body max-w-sm">
              {t('contests.no-winners-desc')}
            </p>
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .judge-entry {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(30px);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
