---
import { Picture } from 'astro:assets';
import { getLangFromUrl, getLocalizedPath } from '../../i18n';

type Props = {
  contest: {
    id: string;
    name: string;
    description: string | null;
    winningImage?: string;
  };
};

const { contest } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
---

<a
  href={getLocalizedPath(`/contest/${contest.id}`, currentLang)}
  class="w-full group block overflow-hidden backdrop-blur-lg bg-gradient-to-br from-white/10 via-blue-500/5 to-transparent border border-white/20 rounded-2xl shadow-2xl transition-all duration-500 hover:border-white/30 hover:shadow-blue-500/20 hover:scale-105 hover:from-white/15"
>
  <!-- Contest Image -->
  <div class="aspect-video overflow-hidden bg-slate-900/50 relative">
    {
      contest.winningImage && (
        <>
          <Picture
            width={400}
            height={400}
            src={contest.winningImage}
            alt={contest.name}
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
          />
          {/* Subtle gradient overlay */}
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          {/* Glass shine effect */}
          <div class="absolute inset-0 bg-gradient-to-br from-white/20 via-transparent to-transparent opacity-0 group-hover:opacity-30 transition-opacity duration-500"></div>
        </>
      )
    }
  </div>

  <!-- Card Content -->
  <div class="p-6 space-y-4 backdrop-blur-sm bg-gradient-to-br from-white/5 to-transparent">
    <!-- Contest Info -->
    <div class="gap-3 flex justify-between items-center">
      <h3 class="text-2xl font-light text-white tracking-wide drop-shadow-lg">
        {contest.name}
      </h3>
      <div class="text-blue-300 group-hover:text-white transition-colors duration-300">
        <svg
          class="w-6 h-6 group-hover:translate-x-1 transition-transform duration-300"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </div>
    </div>
  </div>
</a>
