---
import {
  getCategoryName,
  getLangFromUrl,
  getResultName,
  useTranslations,
} from '@/i18n';
import { getFullQualityImageUrl, getImageApiUrl } from '@/server/imageService';
import GalleryInfo from './GalleryInfo.astro';
import Layout from './Layout.astro';
import {
  getAllWinnersByContestAndCategory,
  getCategoryNamesByIds,
  getContestTitleByContestId,
} from './queries';
import RunnerUpImages from './RunnerUpImages.astro';
import TopWinnerImage from './TopWinnerImage.astro';

type Props = {
  contestId: string;
  categoryId: string;
};

const { contestId, categoryId }: Props = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

if (!Astro.locals.runtime.env.DB) {
  throw new Error('DB is not available');
}

const contestTitle = await getContestTitleByContestId(
  Astro.locals.runtime.env.DB,
  contestId
);

// Fetch results for specific contest and category
const contestResults = await getAllWinnersByContestAndCategory(
  Astro.locals.runtime.env.DB,
  contestId,
  categoryId
);

// Sort results in proper contest order: first, second, third, runner-up
const sortedResults = contestResults.sort((a, b) => {
  const order = { first: 1, second: 2, third: 3, 'runner-up': 4 };
  return (
    order[a.result as keyof typeof order] -
    order[b.result as keyof typeof order]
  );
});

// Get category names
const categoryIds = [...new Set(sortedResults.map(w => w.categoryId))];
const categoryMap = await getCategoryNamesByIds(
  Astro.locals.runtime.env.DB,
  categoryIds
);

// Process images - filter out results without valid images
const processedImages = sortedResults
  .map(result => {
    const categoryName =
      categoryMap.get(result.categoryId) || result.categoryId;
    const translatedCategoryName = getCategoryName(
      result.categoryId,
      categoryName,
      currentLang
    );

    const imageUrl = getImageApiUrl(result.r2ImageId);
    const fullImageUrl = getFullQualityImageUrl(result.r2ImageId);

    return {
      ...result,
      imageUrl,
      fullImageUrl,
      categoryName: translatedCategoryName,
      author:
        result.firstName && result.lastName
          ? `${result.firstName} ${result.lastName}`
          : t('author.anonymous'),
    };
  })
  .filter(
    (w): w is typeof w & { imageUrl: string; fullImageUrl: string } =>
      w.imageUrl !== null && w.fullImageUrl !== null
  );

// Find winners by their actual result, not array position
const firstPlace = processedImages.find(r => r.result === 'first');
const secondPlace = processedImages.find(r => r.result === 'second');
const thirdPlace = processedImages.find(r => r.result === 'third');
const runnerUps = processedImages.filter(r => r.result === 'runner-up');
---

<Layout>
  <GalleryInfo
    contestTitle={contestTitle}
    contestId={contestId}
    activeCategoryId={categoryId}
  />

  <!-- Winners Section -->
  <div class="mt-10 sm:mt-12 space-y-12 sm:space-y-16">
    {
      firstPlace && (
        <TopWinnerImage
          categoryName={firstPlace.categoryName}
          rank={getResultName('First Place', currentLang)}
          rawResult={firstPlace.result}
          imageUrl={firstPlace.imageUrl}
          fullImageUrl={firstPlace.fullImageUrl}
          title={firstPlace.title}
          author={firstPlace.author}
        />
      )
    }

    {
      secondPlace && (
        <TopWinnerImage
          categoryName={secondPlace.categoryName}
          rank={getResultName('Second Place', currentLang)}
          rawResult={secondPlace.result}
          imageUrl={secondPlace.imageUrl}
          fullImageUrl={secondPlace.fullImageUrl}
          title={secondPlace.title}
          author={secondPlace.author}
        />
      )
    }

    {
      thirdPlace && (
        <TopWinnerImage
          categoryName={thirdPlace.categoryName}
          rank={getResultName('Third Place', currentLang)}
          rawResult={thirdPlace.result}
          imageUrl={thirdPlace.imageUrl}
          fullImageUrl={thirdPlace.fullImageUrl}
          title={thirdPlace.title}
          author={thirdPlace.author}
        />
      )
    }

    <!-- Runner Ups -->
    <RunnerUpImages runnerUps={runnerUps} />
  </div>
</Layout>
