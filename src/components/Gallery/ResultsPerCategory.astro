---
import type { Contest, Entry } from '@/data/past-contests';
import {
  getCategoryName,
  getResultName,
  useTranslations,
  type Language,
} from '@/i18n';
import { MEDITERRANEAN_CATEGORY_ID } from '../../constants';
import { getFullQualityImageUrl } from '../../server/imageService';
import GalleryInfo from './GalleryInfo.astro';
import Layout from './Layout.astro';
import MediterraneanPortfolioWinner from './MediterraneanPortfolioWinner.astro';
import RunnerUpImages from './RunnerUpImages.astro';
import TopWinnerImage from './TopWinnerImage.astro';

type Props = {
  contestId: string;
  categoryId: string;
  contestData: Contest;
};

const { contestId, categoryId, contestData }: Props = Astro.props;
const currentLang = (Astro.currentLocale ?? 'en') as Language;
const t = useTranslations(currentLang);

// Get category from contestData
const category = contestData.categories.find(c => c.id === categoryId);
if (!category) {
  throw new Error(`Category ${categoryId} not found in contest ${contestId}`);
}

const isMediterranean = categoryId === MEDITERRANEAN_CATEGORY_ID;
const translatedCategoryName = getCategoryName(
  category.id,
  category.name,
  currentLang
);

const getAuthorName = (entry: Entry) =>
  entry.photographer.firstName && entry.photographer.lastName
    ? `${entry.photographer.firstName} ${entry.photographer.lastName}`
    : t('author.anonymous');

const getPhotographerKey = (entry: Entry) =>
  `${entry.photographer.firstName}-${entry.photographer.lastName}`;

// Group Mediterranean entries by placement + photographer
const groupByPhotographer = (
  entries: Entry[],
  placement: Entry['placement']
) => {
  const filtered = entries.filter(e => e.placement === placement);
  const groups = new Map<string, Entry[]>();

  filtered.forEach(entry => {
    const key = getPhotographerKey(entry);
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key)!.push(entry);
  });

  return Array.from(groups.values()).map(groupEntries => ({
    categoryName: translatedCategoryName,
    author: getAuthorName(groupEntries[0]),
    result: placement,
    images: groupEntries
      .map(entry => ({
        imageUrl: entry.image,
        fullImageUrl: getFullQualityImageUrl(entry.imageR2Id),
        title: entry.title,
      }))
      .filter(
        (img): img is typeof img & { imageUrl: string; fullImageUrl: string } =>
          img.imageUrl !== null && img.fullImageUrl !== null
      ),
  }));
};

// Mediterranean portfolios grouped by placement
const mediterraneanFirst = isMediterranean
  ? groupByPhotographer(category.entries, 'first')
  : [];
const mediterraneanSecond = isMediterranean
  ? groupByPhotographer(category.entries, 'second')
  : [];
const mediterraneanThird = isMediterranean
  ? groupByPhotographer(category.entries, 'third')
  : [];
const mediterraneanRunnerUps = isMediterranean
  ? groupByPhotographer(category.entries, 'runner-up')
  : [];

// Regular category processing (non-Mediterranean)
const sortedEntries = [...category.entries].sort((a, b) => {
  const order = { first: 1, second: 2, third: 3, 'runner-up': 4 };
  return order[a.placement] - order[b.placement];
});

const processedImages = sortedEntries.map(entry => ({
  result: entry.placement,
  imageUrl: entry.image,
  fullImageUrl: getFullQualityImageUrl(entry.imageR2Id),
  categoryName: translatedCategoryName,
  title: entry.title,
  author: getAuthorName(entry),
}));

// Find winners by their actual result (for regular categories)
const firstPlace = processedImages.find(r => r.result === 'first');
const secondPlace = processedImages.find(r => r.result === 'second');
const thirdPlace = processedImages.find(r => r.result === 'third');
const runnerUps = processedImages.filter(r => r.result === 'runner-up');
---

<Layout>
  <GalleryInfo
    contestTitle={contestData.name}
    contestId={contestId}
    activeCategoryId={categoryId}
    contestData={contestData}
  />

  <!-- Winners Section -->
  <div class="mt-10 sm:mt-12 space-y-12 sm:space-y-16">
    {
      isMediterranean ? (
        <>
          {mediterraneanFirst.map(portfolio => (
            <MediterraneanPortfolioWinner
              categoryName={portfolio.categoryName}
              rank={getResultName('First Place', currentLang)}
              rawResult={portfolio.result}
              author={portfolio.author}
              images={portfolio.images}
            />
          ))}

          {mediterraneanSecond.map(portfolio => (
            <MediterraneanPortfolioWinner
              categoryName={portfolio.categoryName}
              rank={getResultName('Second Place', currentLang)}
              rawResult={portfolio.result}
              author={portfolio.author}
              images={portfolio.images}
            />
          ))}

          {mediterraneanThird.map(portfolio => (
            <MediterraneanPortfolioWinner
              categoryName={portfolio.categoryName}
              rank={getResultName('Third Place', currentLang)}
              rawResult={portfolio.result}
              author={portfolio.author}
              images={portfolio.images}
            />
          ))}

          {mediterraneanRunnerUps.map(portfolio => (
            <MediterraneanPortfolioWinner
              categoryName={portfolio.categoryName}
              rank={getResultName('Runner Ups', currentLang)}
              rawResult={portfolio.result}
              author={portfolio.author}
              images={portfolio.images}
            />
          ))}
        </>
      ) : (
        <>
          {firstPlace && (
            <TopWinnerImage
              categoryName={firstPlace.categoryName}
              rank={getResultName('First Place', currentLang)}
              rawResult={firstPlace.result}
              imageUrl={firstPlace.imageUrl}
              fullImageUrl={firstPlace.fullImageUrl}
              title={firstPlace.title}
              author={firstPlace.author}
            />
          )}

          {secondPlace && (
            <TopWinnerImage
              categoryName={secondPlace.categoryName}
              rank={getResultName('Second Place', currentLang)}
              rawResult={secondPlace.result}
              imageUrl={secondPlace.imageUrl}
              fullImageUrl={secondPlace.fullImageUrl}
              title={secondPlace.title}
              author={secondPlace.author}
            />
          )}

          {thirdPlace && (
            <TopWinnerImage
              categoryName={thirdPlace.categoryName}
              rank={getResultName('Third Place', currentLang)}
              rawResult={thirdPlace.result}
              imageUrl={thirdPlace.imageUrl}
              fullImageUrl={thirdPlace.fullImageUrl}
              title={thirdPlace.title}
              author={thirdPlace.author}
            />
          )}

          <RunnerUpImages runnerUps={runnerUps} />
        </>
      )
    }
  </div>
</Layout>
