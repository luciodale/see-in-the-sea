---
import { type Contest, pastContestsData } from "@/data/past-contests";
import type { Language } from "@/i18n/translations";
import { getLocalizedPath, useTranslations } from "@/i18n/utils";
import CategorySelect from "./CategorySelect.astro";
import YearsTimeline from "./YearsTimeline.astro";

type Props = {
  contestTitle: string;
  contestId: string;
  activeCategoryId?: string;
  contestData: Contest;
};

const { contestTitle, contestId, activeCategoryId, contestData } = Astro.props;
const currentLang = (Astro.currentLocale ?? "en") as Language;
const t = useTranslations(currentLang);

const contestJudges = contestData.judges;

const sortedContests = pastContestsData
  .filter((c) => !c.currentContest)
  .map((c) => ({ id: c.id, name: c.name, year: c.year }))
  .sort((a, b) => b.year - a.year);
const currentIndex = sortedContests.findIndex((c) => c.id === contestId);
const prevContest =
  currentIndex < sortedContests.length - 1
    ? sortedContests[currentIndex + 1]
    : null;
const nextContest = currentIndex > 0 ? sortedContests[currentIndex - 1] : null;
---

<header class="space-y-12 sm:space-y-16 pb-12">
  <YearsTimeline
    contests={sortedContests}
    activeContestId={contestId}
    linkPrefix="contest"
    lang={currentLang}
  />

  <!-- Contest title with inline prev/next navigation (all breakpoints) -->
  <div class="flex items-center justify-center gap-4 sm:gap-8">
    {
      nextContest ? (
        <a
          href={getLocalizedPath(`contest/${nextContest.id}`, currentLang)}
          class="group flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors duration-300 text-editorial uppercase tracking-editorial flex-shrink-0"
          title={`${nextContest.year}`}
          aria-label={`Previous contest: ${nextContest.year}`}
        >
          <svg
            class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M15 19l-7-7 7-7"
            />
          </svg>
          <span class="hidden md:inline">{nextContest.year}</span>
        </a>
      ) : (
        <span class="w-5 md:w-16 flex-shrink-0" aria-hidden="true" />
      )
    }

    <h1
      class="font-serif text-4xl sm:text-6xl md:text-7xl lg:text-8xl text-foreground leading-display-tight tracking-display text-center"
    >
      {contestTitle}
    </h1>

    {
      prevContest ? (
        <a
          href={getLocalizedPath(`contest/${prevContest.id}`, currentLang)}
          class="group flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors duration-300 text-editorial uppercase tracking-editorial flex-shrink-0"
          title={`${prevContest.year}`}
          aria-label={`Next contest: ${prevContest.year}`}
        >
          <span class="hidden md:inline">{prevContest.year}</span>
          <svg
            class="w-5 h-5 transform group-hover:translate-x-1 transition-transform duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </a>
      ) : (
        <span class="w-5 md:w-16 flex-shrink-0" aria-hidden="true" />
      )
    }
  </div>

  <!-- Director + Jury -->
  <div
    class="grid grid-cols-1 sm:grid-cols-2 gap-y-8 sm:gap-x-16 max-w-3xl mx-auto text-center"
  >
    <div class="space-y-2">
      <p
        class="text-editorial uppercase tracking-editorial-wider text-muted-foreground"
      >
        {t("submissions.technical-director")}
      </p>
      <p class="font-serif text-lg text-foreground leading-heading">
        Giuseppe Pignataro
      </p>
    </div>
    <div class="space-y-2">
      <p
        class="text-editorial uppercase tracking-editorial-wider text-muted-foreground"
      >
        {t("submissions.jury")}
      </p>
      <p class="font-serif text-lg text-foreground leading-heading">
        {contestJudges.map((j) => j.fullName).join(", ")}
      </p>
    </div>
  </div>
</header>

<div class="pb-8">
  <CategorySelect
    contestId={contestId}
    activeCategoryId={activeCategoryId}
    categories={contestData.categories}
    lang={currentLang}
  />
</div>
