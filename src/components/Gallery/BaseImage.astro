---
import { Picture } from 'astro:assets';

type Props = {
  imageUrl: string;
  showInfo?: boolean;
  title: string;
  author: string;
};

const { imageUrl, title, author, showInfo = true }: Props = Astro.props;
---

<div class="group/image relative overflow-hidden bg-background">
  <!-- Main Image -->
  <Picture
    width={1000}
    height={1000}
    class="w-full object-cover transition-transform duration-700 group-hover/image:scale-105"
    src={imageUrl}
    alt={title}
    loading="lazy"
  />

  <!-- Subtle gradient overlay for depth -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover/image:opacity-100 transition-opacity duration-500 pointer-events-none"
  >
  </div>

  <!-- Glass shine effect on hover -->
  <div
    class="absolute inset-0 bg-gradient-to-br from-white/20 via-transparent to-transparent opacity-0 group-hover/image:opacity-30 transition-opacity duration-500 pointer-events-none"
  >
  </div>

  {
    showInfo && (
      <div class="backdrop-blur-sm bg-black/30 px-6 py-4 border-t border-border">
        <p class="font-serif text-foreground text-center leading-heading">
          {author}
        </p>
      </div>
    )
  }
</div>
