---
import { Picture } from 'astro:assets';

type Props = {
  title: string;
  image: string;
  isRight?: boolean;
};

const { title, image, isRight = false } = Astro.props;
---

<div class="flex items-center justify-center">
  <div
    class="mx-auto grid max-w-2xl lg:max-w-full lg:grid-cols-2 gap-12 lg:gap-16 items-center"
  >
    <!-- Text Content -->
    <div class={`space-y-6 ${isRight ? 'lg:order-2' : 'lg:order-1'}`}>
      <p class="text-editorial uppercase tracking-editorial-wider text-muted-foreground">
        {title}
      </p>
      <div
        class="font-light text-sm sm:text-base text-foreground/80 leading-paragraph max-w-prose-narrow space-y-4"
      >
        <slot />
      </div>
    </div>

    <!-- Image -->
    <div class={`${isRight ? 'lg:order-1' : 'lg:order-2'}`}>
      <div class="aspect-[4/5] overflow-hidden bg-surface rounded-sm">
        <Picture
          width={1000}
          height={1250}
          src={image}
          alt={title}
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </div>
</div>
