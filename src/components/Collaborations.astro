---
import { useTranslations, type Language } from '@/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
---

<div class="bg-gray-950 text-white text-center py-4">
  <h2 class="sm:text-xl text-lg font-extralight">
    {t('collaborations.title')}
  </h2>
  <div
    class="flex flex-col-reverse sm:flex-row justify-center items-center gap-4 mt-2 sm:gap-36 pt-2"
  >
    <div class="w-40 flex items-center justify-center">
      <img
        src="/images/collabs/zeropixel-logo.png"
        alt="Zeropixel"
        loading="lazy"
      />
    </div>
    <div class="w-40 flex items-center justify-center">
      <img
        src="/images/collabs/scubaportal-logo.png"
        alt="Scubaportal"
        loading="lazy"
      />
    </div>
  </div>
</div>
