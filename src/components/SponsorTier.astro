---
import type { Sponsor } from '@/constants/sponsors';

interface Props {
  sponsors: Sponsor[];
  tier: Sponsor['tier'];
}

const { sponsors } = Astro.props as Props;
---

<div class="mb-12">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      sponsors.map(sponsor => (
        <div class="bg-surface border border-border rounded-2xl p-8 backdrop-blur-sm transition-all duration-300 hover:border-border-strong hover:bg-surface-hover/60">
          <div class="text-center space-y-6">
            <div class="flex justify-center">
              <div class="w-20 h-20 bg-surface-raised rounded-xl flex items-center justify-center p-3 border border-border">
                <img
                  src={sponsor.logo}
                  alt={`${sponsor.name} logo`}
                  class="max-w-full max-h-full object-contain"
                  loading="lazy"
                />
              </div>
            </div>

            <div class="space-y-3">
              <h3 class="font-serif text-xl text-foreground leading-heading">
                {sponsor.name}
              </h3>

              {sponsor.description && (
                <p class="font-light text-sm text-muted-foreground leading-body">
                  {sponsor.description}
                </p>
              )}

              {sponsor.website && (
                <a
                  href={sponsor.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 bg-surface border border-border rounded-full text-editorial uppercase tracking-editorial transition-all duration-300 hover:bg-surface-hover hover:border-border-strong text-foreground/85 hover:text-foreground"
                >
                  <svg
                    class="w-3 h-3"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    />
                  </svg>
                  Visit Website
                </a>
              )}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>
