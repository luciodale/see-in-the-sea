---
import type { Sponsor } from '@/constants/sponsors';

interface Props {
  sponsors: Sponsor[];
  tier: Sponsor['tier'];
}

const { sponsors, tier } = Astro.props as Props;

const getTierStyles = (tier: Sponsor['tier']) => {
  // All tiers use the same styling, only ordering matters
  return {
    border: 'border-gray-400/30',
    bg: 'bg-gradient-to-br from-gray-800/20 to-gray-700/20',
    scale: 'scale-100',
    shadow: 'shadow-md'
  };
};

const styles = getTierStyles(tier);
---

<div class="mb-12">
  <!-- Sponsors Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {sponsors.map((sponsor) => (
      <div class={`${styles.bg} border ${styles.border} rounded-xl p-6 backdrop-blur-sm transition-all duration-300 hover:${styles.scale} hover:${styles.shadow}`}>
        <div class="text-center space-y-4">
          <!-- Logo -->
          <div class="flex justify-center">
            <div class="w-20 h-20 bg-white/5 rounded-lg flex items-center justify-center p-3 border border-white/10">
              <img 
                src={sponsor.logo} 
                alt={`${sponsor.name} logo`}
                class="max-w-full max-h-full object-contain"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Sponsor Info -->
          <div class="space-y-2">
            <h3 class="text-lg font-medium text-gray-100 uppercase tracking-wide">
              {sponsor.name}
            </h3>
            
            {sponsor.description && (
              <p class="text-sm text-gray-300 leading-relaxed">
                {sponsor.description}
              </p>
            )}

            {sponsor.website && (
              <a 
                href={sponsor.website}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-3 py-2 bg-white/5 border border-white/10 rounded-lg text-sm font-medium transition-all duration-300 hover:bg-white/10 hover:border-white/20 text-gray-200"
              >
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                Visit Website
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
