---
import type { Language } from '@/i18n/translations';
import { NavbarHeaderWithI18n } from './NavbarHeaderWithI18n';

interface Props {
  lang?: Language;
  darkOverlay?: boolean;
}

const { lang = 'en', darkOverlay = false } = Astro.props;

const PUBLIC_CLERK_PUBLISHABLE_KEY = import.meta.env
  .PUBLIC_CLERK_PUBLISHABLE_KEY;

if (!PUBLIC_CLERK_PUBLISHABLE_KEY) {
  throw new Error('Clerk public key is required');
}
---

<NavbarHeaderWithI18n
  clerkPublicKey={PUBLIC_CLERK_PUBLISHABLE_KEY}
  client:load
  lang={lang}
  darkOverlay={darkOverlay}
/>
