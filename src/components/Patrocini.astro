---
import { useTranslations, type Language } from '@/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
---

<div class="bg-gray-950 text-white text-center py-4">
  <p class="sm:text-2xl text-lg font-extralight">{t('patrocini.title')}</p>
  <div
    class="flex flex-col-reverse sm:flex-row justify-center items-center sm:gap-36 pt-2"
  >
    <div class="sm:w-96 w-60">
      <img
        src="/images/patrocini/one-ocean-young-logo.svg"
        alt="One Ocean Young"
        loading="lazy"
      />
    </div>
    <div class="w-28">
      <img
        src="/images/patrocini/ortona-logo.png"
        alt="Ortona"
        loading="lazy"
      />
    </div>
    <div class="sm:w-96 w-60">
      <img
        src="/images/patrocini/arpa-abruzzo-logo.svg"
        alt="ARPA Abruzzo"
        loading="lazy"
      />
    </div>
  </div>
</div>
