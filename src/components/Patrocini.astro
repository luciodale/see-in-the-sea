---
import { useTranslations, type Language } from '@/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
---

<div class="bg-slate-700/80 text-white text-center py-2">
  <p class="text-2xl font-extralight">{t('patrocini.title')}</p>
  <div class="flex justify-center items-center gap-4 pt-2">
    <img
      src="/images/patrocini/one-ocean-young-logo.svg"
      alt="One Ocean Young"
      class="sm:w-56 w-32"
      loading="lazy"
    />
    <img
      src="/images/patrocini/arpa-abruzzo-logo.svg"
      alt="ARPA Abruzzo"
      class="sm:w-56 w-32"
      loading="lazy"
    />
  </div>
</div>
