---
import AppWrapper from '@/components/AppWrapper.astro';
import Layout from '@/components/Gallery/Layout.astro';
import NavbarHeaderStandalone from '@/components/Navbar/NavbarHeaderStandalone.astro';
import {
  sponsorAlbatros,
  sponsorAlbatrosMain,
  sponsors,
} from '@/constants/sponsors';
import { type Language, useTranslations } from '@/i18n';

interface Props {
  lang: Language;
  alternates?: Array<{ hrefLang: string; href: string }>;
}

const { lang, alternates = [] } = Astro.props as Props;
const t = useTranslations(lang);

import SponsorImage from '../SponsorImage.astro';
---

<AppWrapper
  title={t('sponsors.title')}
  description={t('sponsors.subtitle')}
  lang={lang}
  alternates={alternates}
>
  <NavbarHeaderStandalone lang={lang} />

  <Layout>
    <!-- Hero Section -->
    <div class="text-center mb-20 space-y-6">
      <h1
        class="text-5xl sm:text-7xl font-extralight text-white uppercase tracking-[0.2em] drop-shadow-2xl"
      >
        {t('sponsors.title')}
      </h1>

      <p
        class="text-lg font-light text-gray-300 leading-relaxed max-w-2xl mx-auto"
      >
        {t('sponsors.subtitle')}
      </p>
    </div>

    <!-- All Sponsors Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-24">
      <!-- Albatros Main -->
      <div
        class="backdrop-blur-lg bg-gradient-to-br from-white/5 to-transparent rounded-2xl border border-white/10 p-10 shadow-xl hover:border-white/20 hover:from-white/8 transition-all duration-500 group"
      >
        <div class="flex items-center justify-center h-full">
          <SponsorImage
            sponsor={sponsorAlbatrosMain}
            imageClass="w-full max-w-xs object-contain opacity-90 group-hover:opacity-100 transition-opacity duration-300"
          />
        </div>
      </div>

      <!-- Albatros Subsidiaries -->
      {
        sponsorAlbatros.map(sponsor => (
          <div class="backdrop-blur-lg bg-gradient-to-br from-white/5 to-transparent rounded-2xl border border-white/10 p-10 shadow-xl hover:border-white/20 hover:from-white/8 transition-all duration-500 group">
            <div class="flex items-center justify-center h-full">
              <SponsorImage
                sponsor={sponsor}
                imageClass={`${sponsor.width ?? 'w-48'} max-w-full object-contain opacity-90 group-hover:opacity-100 transition-opacity duration-300`}
              />
            </div>
          </div>
        ))
      }

      <!-- Other Sponsors -->
      {
        sponsors.map(sponsor => (
          <div class="backdrop-blur-lg bg-gradient-to-br from-white/5 to-transparent rounded-2xl border border-white/10 p-10 shadow-xl hover:border-white/20 hover:from-white/8 transition-all duration-500 group">
            <div class="flex flex-col items-center justify-center h-full space-y-4">
              <div class="flex-1 flex items-center justify-center w-full">
                <SponsorImage
                  sponsor={sponsor}
                  imageClass={`${sponsor.width ?? 'w-48'} max-w-full object-contain opacity-90 group-hover:opacity-100 transition-opacity duration-300`}
                />
              </div>
              {sponsor.name && (
                <span class="text-gray-300 text-sm font-light tracking-wide">
                  {sponsor.name}
                </span>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <!-- Become a Sponsor CTA -->
    <div class="max-w-4xl mx-auto mt-24">
      <div
        class="backdrop-blur-xl bg-gradient-to-br from-white/5 via-cyan-500/5 to-transparent rounded-3xl border border-white/10 p-12 shadow-2xl hover:border-white/20 transition-all duration-500"
      >
        <div class="text-center space-y-8">
          <!-- Icon -->
          <div class="flex justify-center">
            <div
              class="w-20 h-20 bg-gradient-to-br from-cyan-500/20 to-blue-600/20 rounded-full flex items-center justify-center border border-cyan-400/20 shadow-lg shadow-cyan-500/10"
            >
              <svg
                class="w-10 h-10 text-cyan-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                ></path>
              </svg>
            </div>
          </div>

          <!-- Title -->
          <h2
            class="text-3xl md:text-4xl font-light text-white uppercase tracking-wide"
          >
            {t('sponsors.become-sponsor')}
          </h2>

          <!-- Description -->
          <p
            class="text-base md:text-lg font-light text-gray-300 leading-relaxed max-w-2xl mx-auto"
          >
            {t('sponsors.contact')}
          </p>

          <!-- CTA Button -->
          <div class="pt-4">
            <a
              href="mailto:info@ortonasub.com"
              class="inline-flex items-center px-8 py-4 bg-white/10 hover:bg-white/15 border border-white/20 hover:border-white/30 text-white rounded-xl transition-all duration-300 text-base font-medium tracking-wide uppercase"
            >
              {t('sponsors.become-sponsor')}
            </a>
          </div>
        </div>
      </div>
    </div>
  </Layout>
</AppWrapper>
