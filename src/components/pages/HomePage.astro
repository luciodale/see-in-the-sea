---
import AppWrapper from '@/components/AppWrapper.astro';
import HeroSegment from '@/components/HeroSegment.astro';
import { Navbar } from '@/components/Navbar/Navbar';
import SponsorsBanner from '@/components/SponsorsBanner.astro';
import { getLocalizedPath, useTranslations, type Language } from '@/i18n';
import Layout from '../Gallery/Layout.astro';
import PartnersSection from '../PartnersSection.astro';

interface Props {
  lang: Language;
  alternates?: Array<{ hrefLang: string; href: string }>;
}

const { lang, alternates = [] } = Astro.props as Props;
const t = useTranslations(lang);

const PUBLIC_CLERK_PUBLISHABLE_KEY = import.meta.env
  .PUBLIC_CLERK_PUBLISHABLE_KEY;
---

<AppWrapper
  title={t('site.title')}
  description={t('site.description')}
  lang={lang}
  alternates={alternates}
>
  <Navbar
    client:load
    lang={lang}
    clerkPublicKey={PUBLIC_CLERK_PUBLISHABLE_KEY}
  />

  <!-- Sponsors Marquee -->
  <div class="relative z-0">
    <SponsorsBanner />
    <PartnersSection lang={lang} />
  </div>

  <Layout>
    <div class="flex flex-col gap-24 lg:gap-32">
      <!-- Who We Are -->
      <HeroSegment
        title={t('home.who-we-are.title')}
        description={t('home.who-we-are.description')}
        image={{ link: '/images/two-logos.svg' }}
        buttonCTA={{
          text: t('action.learn-more'),
          link: getLocalizedPath('about', lang),
        }}
      />

      <!-- Past Contests -->
      <HeroSegment
        title={t('home.past-contests.title')}
        isRight={true}
        description={t('home.past-contests.description')}
        image={{ link: '/images/home/past-contests.webp', objectFit: true }}
        buttonCTA={{
          text: t('home.past-contests.button'),
          link: getLocalizedPath('contest', lang),
        }}
      />

      <!-- Sponsors -->
      <HeroSegment
        title={t('home.sponsors.title')}
        description={t('home.sponsors.description')}
        image={{ link: '/images/home/sponsors.webp', objectFit: true }}
        buttonCTA={{
          text: t('home.sponsors.button'),
          link: getLocalizedPath('sponsors', lang),
        }}
      />
    </div>
  </Layout>
</AppWrapper>
