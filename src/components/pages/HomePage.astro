---
import AppWrapper from '@/components/AppWrapper.astro';
import HeroSegment from '@/components/HeroSegment.astro';
import { Navbar } from '@/components/Navbar/Navbar';
import type { Language } from '@/i18n/translations';
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import Layout from '../Gallery/Layout.astro';
import PartnersSection from '../PartnersSection.astro';

interface Props {
  lang: Language;
  alternates?: Array<{ hrefLang: string; href: string }>;
}

const { lang, alternates = [] } = Astro.props as Props;
const t = useTranslations(lang);

const PUBLIC_CLERK_PUBLISHABLE_KEY = import.meta.env
  .PUBLIC_CLERK_PUBLISHABLE_KEY;
---

<AppWrapper
  title={t('site.title')}
  description={t('site.description')}
  lang={lang}
  alternates={alternates}
>
  <Navbar
    client:load
    lang={lang}
    clerkPublicKey={PUBLIC_CLERK_PUBLISHABLE_KEY}
  />

  <!-- Sponsors invitation + Partners -->
  <div class="relative z-0">
    <div class="bg-background border-t border-border px-4 py-10">
      <div
        class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-center gap-6 text-center"
      >
        <p
          class="font-serif text-xl sm:text-2xl text-foreground leading-heading"
        >
          {t('home.sponsors.invite')}
        </p>
        <a
          href={getLocalizedPath('sponsors', lang)}
          class="inline-flex items-center gap-2 px-7 py-3 rounded-full border border-foreground bg-transparent text-foreground text-xs uppercase tracking-editorial-wide font-medium hover:bg-foreground hover:text-background transition-colors flex-shrink-0"
        >
          {t('home.sponsors.button')}
        </a>
      </div>
    </div>
    <PartnersSection lang={lang} />
  </div>

  <Layout>
    <div class="flex flex-col gap-24 lg:gap-32">
      <!-- Past Contests -->
      <HeroSegment
        title={t('home.past-contests.title')}
        description={t('home.past-contests.description')}
        image={{ link: '/images/home/past-contests.webp', objectFit: true }}
        buttonCTA={{
          text: t('home.past-contests.button'),
          link: getLocalizedPath('contest', lang),
        }}
      />

      <!-- Sponsors -->
      <HeroSegment
        title={t('home.sponsors.title')}
        description={t('home.sponsors.description')}
        image={{ link: '/images/home/sponsors.webp', objectFit: true }}
        isRight={true}
        buttonCTA={{
          text: t('home.sponsors.button'),
          link: getLocalizedPath('sponsors', lang),
        }}
      />

      <!-- Trophy -->
      <HeroSegment
        title={t('home.trophy.title')}
        description={t('home.trophy.description')}
        image={{ link: '/images/home/trophy.webp', objectFit: true }}
        buttonCTA={{
          text: t('home.trophy.button'),
          link: getLocalizedPath('trophy', lang),
        }}
      />
    </div>
  </Layout>
</AppWrapper>
