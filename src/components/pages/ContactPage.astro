---
import AppWrapper from '@/components/AppWrapper.astro';
import EmailLink from '@/components/EmailLink.astro';
import Layout from '@/components/Gallery/Layout.astro';
import NavbarHeaderStandalone from '@/components/Navbar/NavbarHeaderStandalone.astro';
import PageHero from '@/components/ui/PageHero.astro';
import type { Language } from '@/i18n/translations';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const heading = lang === 'it' ? 'Contatti' : 'Contact Us';

const contacts = [
  {
    role: t('contact.president'),
    name: 'Paolo De Iure',
    phone: '339 657 7950',
  },
  {
    role: t('contact.technical-director'),
    name: 'Giuseppe Pignataro',
    phone: '328 593 4373',
  },
  {
    role: t('contact.administrative-secretary'),
    name: 'Gabriele Di Credico',
    phone: '347 888 9007',
  },
  {
    role: t('contact.administrative-secretary'),
    name: 'Fabrizio Pompilio',
    phone: '390 391 9121',
  },
  {
    role: t('contact.web-master'),
    name: "Lucio D'Alessandro",
  },
];
---

<AppWrapper
  title={t('seo.contact.title')}
  description={t('seo.contact.description')}
  lang={lang}
>
  <NavbarHeaderStandalone lang={lang} />
  <Layout>
    <div class="max-w-5xl mx-auto">
      <PageHero title={heading} class="mb-16" />

      <!-- Organization Info Card -->
      <div class="text-center mb-12">
        <div class="inline-block">
          <h2
            class="font-serif text-2xl sm:text-3xl text-foreground/90 leading-heading mb-3"
          >
            {t('contact.organization')}
          </h2>
          <p class="text-muted-foreground text-sm leading-body mb-4">
            {t('contact.address-details')}
          </p>
          <EmailLink variant="large" showLabel={true} />
        </div>
      </div>

      <!-- Contact Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-16">
        {
          contacts.map(contact => (
            <div class="group relative backdrop-blur-sm bg-surface/60 border border-border rounded-lg p-6 hover:border-border-strong transition-colors duration-300">
              <p class="text-editorial text-muted-foreground uppercase tracking-editorial-wider mb-2">
                {contact.role}
              </p>
              <p class="font-serif text-foreground text-xl mb-1">
                {contact.name}
              </p>
              {contact.phone && (
                <a
                  href={`tel:+39${contact.phone.replace(/\s/g, '')}`}
                  class="text-muted-foreground text-sm hover:text-foreground transition-colors"
                >
                  +39 {contact.phone}
                </a>
              )}
            </div>
          ))
        }
      </div>

      <!-- Map Section -->
      <div class="relative">
        <div class="text-center mb-6">
          <p
            class="text-editorial text-muted-foreground uppercase tracking-editorial-wider"
          >
            {lang === 'it' ? 'Dove Siamo' : 'Find Us'}
          </p>
        </div>
        <div class="rounded-xl overflow-hidden border border-border">
          <iframe
            title="Google Map"
            style="width:100%;height:350px"
            src="https://www.google.com/maps?q=ortona%20sub&output=embed&hl=it-IT&z=12"
          ></iframe>
        </div>
      </div>
    </div>
  </Layout>
</AppWrapper>
