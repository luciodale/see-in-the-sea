---
import AboutSegment from '@/components/AboutSegment.astro';
import AppWrapper from '@/components/AppWrapper.astro';
import Layout from '@/components/Gallery/Layout.astro';
import NavbarHeaderStandalone from '@/components/Navbar/NavbarHeaderStandalone.astro';
import PageHero from '@/components/ui/PageHero.astro';
import type { Language } from '@/i18n/translations';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Language;
  alternates?: Array<{ hrefLang: string; href: string }>;
}

const { lang, alternates = [] } = Astro.props as Props;
const t = useTranslations(lang);
---

<AppWrapper
  title={t('site.title')}
  description={t('site.description')}
  lang={lang}
  alternates={alternates}
>
  <NavbarHeaderStandalone lang={lang} />

  <Layout>
    <PageHero
      eyebrow={t('about.title')}
      title={t('about.section1.title')}
      class="mb-24"
    />

    <div class="flex flex-col gap-28 sm:gap-32">
      <AboutSegment
        title={t('about.section1.title')}
        image="/images/about/about-diver.webp"
        isRight={false}
      >
        <p>{t('about.section1.paragraph1')}</p>
        <p>{t('about.section1.paragraph2')}</p>
        <p>{t('about.section1.paragraph3')}</p>
      </AboutSegment>

      <AboutSegment
        title={t('about.section2.title')}
        image="/images/about/about-group.webp"
        isRight={true}
      >
        <p>
          {t('about.section2.paragraph1')}
        </p>
        <p>{t('about.section2.paragraph2')}</p>
        <p>{t('about.section2.paragraph3')}</p>
      </AboutSegment>

      <AboutSegment
        title={t('about.section3.title')}
        image="/images/about/about-sea.webp"
        isRight={false}
      >
        <p>
          {t('about.section3.paragraph1')}
          {t('about.section3.emphasis')}
        </p>
        <p>{t('about.section3.paragraph2')}</p>
      </AboutSegment>

      <!-- Closing Quote Section -->
      <div class="max-w-3xl mx-auto text-center space-y-10 pt-16">
        <blockquote
          class="font-serif text-3xl sm:text-4xl text-foreground italic leading-heading"
        >
          “{t('about.quote')}”
        </blockquote>

        <div class="pt-10 border-t border-border space-y-1">
          <p class="font-serif text-xl text-foreground leading-heading">
            {t('about.author')}
          </p>
          <p class="text-editorial uppercase tracking-editorial-wider text-muted-foreground">
            {t('about.position')}
          </p>
        </div>
      </div>
    </div>
  </Layout>
</AppWrapper>
