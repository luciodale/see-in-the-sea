---
import AppWrapper from '@/components/AppWrapper.astro';
import { pastContestsData } from '@/data/past-contests';
import type { Language } from '@/i18n/translations';
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import { ContestSlider } from '@/react/components/ContestSlider';
import { NavbarHeaderWithI18n } from '../Navbar/NavbarHeaderWithI18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contestsWithLinks = pastContestsData
  .filter(c => !c.currentContest)
  .map(c => ({
    ...c,
    link: getLocalizedPath(`/contest/${c.id}`, lang),
  }));

const PUBLIC_CLERK_PUBLISHABLE_KEY = import.meta.env
  .PUBLIC_CLERK_PUBLISHABLE_KEY;
---

<AppWrapper
  title={t('site.title')}
  description={t('site.description')}
  lang={lang}
>
  <NavbarHeaderWithI18n
    clerkPublicKey={PUBLIC_CLERK_PUBLISHABLE_KEY}
    client:only="react"
    lang={lang}
  />
  <!-- Contest Slider with Liquid Glass Background -->
  <div class="w-full">
    {
      contestsWithLinks.length > 0 ? (
        <ContestSlider client:load contests={contestsWithLinks} lang={lang} />
      ) : (
        <div class="min-h-screen w-full bg-background flex items-center justify-center">
          <div class="col-span-full text-center py-16">
            <div class="backdrop-blur-xl bg-surface/60 rounded-3xl border border-border p-12 shadow-2xl max-w-lg mx-auto">
              <div class="text-6xl mb-6">🏆</div>
              <h3 class="font-serif text-4xl text-foreground mb-4 leading-display">
                {t('contests.no-contests')}
              </h3>
              <p class="text-muted-foreground text-base leading-body">{t('contests.check-back')}</p>
            </div>
          </div>
        </div>
      )
    }
  </div>
</AppWrapper>
