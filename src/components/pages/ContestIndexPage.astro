---
import AppWrapper from '@/components/AppWrapper.astro';
import { pastContestsData } from '@/data/past-contests';
import { getLocalizedPath, useTranslations, type Language } from '@/i18n';
import { ContestSlider } from '@/react/components/ContestSlider';
import { NavbarHeaderWithI18n } from '../Navbar/NavbarHeaderWithI18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contestsWithLinks = pastContestsData.map(c => ({
  ...c,
  link: getLocalizedPath(`/contest/${c.id}`, lang),
}));

const PUBLIC_CLERK_PUBLISHABLE_KEY = import.meta.env
  .PUBLIC_CLERK_PUBLISHABLE_KEY;
---

<AppWrapper
  title={t('site.title')}
  description={t('site.description')}
  lang={lang}
>
  <div
    class="backdrop-blur-xl bg-slate-900/80 border-b border-slate-700/50 sticky top-0 z-50 shadow-lg"
  >
    <NavbarHeaderWithI18n
      clerkPublicKey={PUBLIC_CLERK_PUBLISHABLE_KEY}
      client:only="react"
      lang={lang}
      standalone={true}
    />
  </div>
  <!-- Contest Slider with Liquid Glass Background -->
  <div class="w-full">
    {
      contestsWithLinks.length > 0 ? (
        <ContestSlider client:load contests={contestsWithLinks} />
      ) : (
        <div class="min-h-screen w-full bg-gradient-to-b from-slate-900 to-gray-900 flex items-center justify-center">
          <div class="col-span-full text-center py-16">
            <div class="backdrop-blur-xl bg-gradient-to-br from-white/10 via-blue-500/5 to-transparent rounded-3xl border border-white/20 p-12 shadow-2xl max-w-lg mx-auto">
              <div class="text-6xl mb-6">🏆</div>
              <h3 class="text-3xl font-light text-white mb-4 tracking-wide">
                {t('contests.no-contests')}
              </h3>
              <p class="text-gray-300 text-lg">{t('contests.check-back')}</p>
            </div>
          </div>
        </div>
      )
    }
  </div>
</AppWrapper>
