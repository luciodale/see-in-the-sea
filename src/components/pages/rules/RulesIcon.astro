---
import { iconPaths, type RulesIconName } from './icons';

type Props = {
  name: RulesIconName;
  class?: string;
};

const { name, class: className = 'w-5 h-5' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"><Fragment set:html={iconPaths[name]} /></svg>
