---
import { type Sponsor, sponsorsMeta } from '../constants/sponsors';

const sponsorsBanner: Sponsor[] = [
  {
    logo: '/images/sponsors-banner/easy-dive.png',
    website: sponsorsMeta.easyDive.website,
  },
  {
    logo: '/images/sponsors-banner/isotta.png',
    website: sponsorsMeta.isotta.website,
  },

  {
    logo: '/images/sponsors-banner/albatros.png',
    website: sponsorsMeta.albatros.website,
  },
  {
    logo: '/images/sponsors-banner/ciampoli.png',
  },
  {
    logo: '/images/sponsors-banner/pgs.png',
    website: sponsorsMeta.pgs.website,
  },
  {
    logo: '/images/sponsors-banner/lega-navale-ortona.png',
    website: sponsorsMeta.legaNavale.website,
  },
  {
    logo: '/images/sponsors-banner/ssi.png',
    website: sponsorsMeta.ssi.website,
  },
  {
    logo: '/images/sponsors-banner/punto-nave.png',
    website: sponsorsMeta.puntoNave.website,
  },
];
---

<div class="bg-slate-50/80 py-3 overflow-hidden">
  <div class="marquee">
    <!-- prettier-ignore -->
    <ul class="flex items-center gap-12 pr-12">
      {sponsorsBanner.map(s => (
        <li>
          {s.website ? (
            <a
              href={s.website}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.website ?? 'Sponsor'}
              class="block"
            >
              <img
                src={s.logo}
                alt={'Sponsor logo'}
                class="h-10 md:h-16 w-auto opacity-90 hover:opacity-100 transition-opacity"
                loading="lazy"
              />
            </a>
          ) : (
            <img
              src={s.logo}
              alt={'Sponsor logo'}
              class="h-10 md:h-16 w-auto opacity-90"
              loading="lazy"
            />
          )}
        </li>
      ))}
    </ul>
    <!-- prettier-ignore -->
    <ul class="flex items-center gap-12 pr-12" aria-hidden="true">
      {sponsorsBanner.map(s => (
        <li>
          {s.website ? (
            <a
              href={s.website}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.website ?? 'Sponsor'}
              class="block"
            >
              <img
                src={s.logo}
                alt={'Sponsor logo'}
                class="h-10 md:h-16 w-auto opacity-90 hover:opacity-100 transition-opacity"
                loading="lazy"
              />
            </a>
          ) : (
            <img
              src={s.logo}
              alt={'Sponsor logo'}
              class="h-10 md:h-16 w-auto opacity-90"
              loading="lazy"
            />
          )}
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .marquee {
    display: flex;
    width: max-content;
    animation: sitS_marquee 50s linear infinite;
  }
  .marquee:hover {
    animation-play-state: paused;
  }
  /* Faster on mobile */
  @media (max-width: 640px) {
    .marquee {
      animation-duration: 25s;
    }
  }
  @keyframes sitS_marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      animation: none;
    }
  }
</style>
