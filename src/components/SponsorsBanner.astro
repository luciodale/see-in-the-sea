---
import { type Sponsor, sponsorsMeta } from '../constants/sponsors';

const sponsorsBanner: Sponsor[] = [
  {
    logo: '/images/sponsors-banner/easy-dive.png',
    website: sponsorsMeta.easyDive.website,
  },
  {
    logo: '/images/sponsors-banner/isotta.png',
    website: sponsorsMeta.isotta.website,
  },
  {
    logo: '/images/sponsors-banner/aquadiving.png',
    website: sponsorsMeta.aquadiving.website,
  },
  {
    logo: '/images/sponsors-banner/siladen.png',
    website: sponsorsMeta.siladen.website,
  },
  {
    logo: '/images/sponsors-banner/coral-eye.png',
    website: sponsorsMeta.coralEye.website,
  },
  {
    logo: '/images/sponsors-banner/albatros.png',
    website: sponsorsMeta.albatros.website,
  },
  {
    logo: '/images/sponsors-banner/ciampoli.png',
  },
  {
    logo: '/images/sponsors-banner/pgs.png',
    website: sponsorsMeta.pgs.website,
  },
  {
    logo: '/images/sponsors-banner/lega-navale-ortona.png',
    website: sponsorsMeta.legaNavale.website,
  },
  {
    logo: '/images/sponsors-banner/ssi.png',
    website: sponsorsMeta.ssi.website,
  },
  {
    logo: '/images/sponsors-banner/punto-nave.png',
    website: sponsorsMeta.puntoNave.website,
  },
  {
    logo: '/images/sponsors-banner/htc.png',
    website: sponsorsMeta.htc.website,
  },
];
---

<div class="backdrop-blur-sm bg-white/75 py-6 sm:py-8 overflow-hidden border-y border-white/30">
  <div class="marquee">
    <ul class="flex items-center gap-8 pr-8">
      {
        sponsorsBanner.map(s => (
          <li class="w-40 md:w-48">
            {s.website ? (
              <a
                href={s.website}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.website ?? 'Sponsor'}
                class="block"
              >
                <img
                  src={s.logo}
                  alt={'Sponsor logo'}
                  class="w-auto opacity-80 hover:opacity-100 transition-opacity"
                  loading="lazy"
                />
              </a>
            ) : (
              <img
                src={s.logo}
                alt={'Sponsor logo'}
                class="w-auto opacity-80"
                loading="lazy"
              />
            )}
          </li>
        ))
      }
    </ul>
    <ul class="flex items-center gap-8 pr-8" aria-hidden="true">
      {
        sponsorsBanner.map(s => (
          <li class="w-40 md:w-48">
            {s.website ? (
              <a
                href={s.website}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.website ?? 'Sponsor'}
                class="block"
              >
                <img
                  src={s.logo}
                  alt={'Sponsor logo'}
                  class="w-auto opacity-80 hover:opacity-100 transition-opacity"
                  loading="lazy"
                />
              </a>
            ) : (
              <img
                src={s.logo}
                alt={'Sponsor logo'}
                class="w-auto opacity-80"
                loading="lazy"
              />
            )}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .marquee {
    display: flex;
    width: max-content;
    animation: sitS_marquee 50s linear infinite;
    will-change: transform;
    transform: translate3d(0, 0, 0);
    -webkit-transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .marquee > ul {
    flex: none;
  }
  .marquee:hover {
    animation-play-state: paused;
  }
  /* Faster on mobile */
  @media (max-width: 640px) {
    .marquee {
      animation-duration: 25s;
    }
  }
  @keyframes sitS_marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      animation: none;
    }
  }
</style>
