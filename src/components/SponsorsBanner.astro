---
import { type Sponsor, sponsorsMeta } from '../constants/sponsors';

const sponsorsBanner: Sponsor[] = [
  {
    logo: '/images/sponsors-banner/easy-dive.png',
    website: sponsorsMeta.easyDive.website,
  },
  {
    logo: '/images/sponsors-banner/isotta.png',
    website: sponsorsMeta.isotta.website,
  },
  {
    logo: '/images/sponsors-banner/aquadiving.png',
    website: sponsorsMeta.aquadiving.website,
  },
  {
    logo: '/images/sponsors-banner/siladen.png',
    website: sponsorsMeta.siladen.website,
  },
  {
    logo: '/images/sponsors-banner/coral-eye.png',
    website: sponsorsMeta.coralEye.website,
  },
  {
    logo: '/images/sponsors-banner/albatros.png',
    website: sponsorsMeta.albatros.website,
  },
  {
    logo: '/images/sponsors-banner/ciampoli.png',
  },
  {
    logo: '/images/sponsors-banner/pgs.png',
    website: sponsorsMeta.pgs.website,
  },
  {
    logo: '/images/sponsors-banner/lega-navale-ortona.png',
    website: sponsorsMeta.legaNavale.website,
  },
  {
    logo: '/images/sponsors-banner/ssi.png',
    website: sponsorsMeta.ssi.website,
  },
  {
    logo: '/images/sponsors-banner/punto-nave.png',
    website: sponsorsMeta.puntoNave.website,
  },
  {
    logo: '/images/sponsors-banner/htc.png',
    website: sponsorsMeta.htc.website,
  },
  {
    logo: '/images/sponsors-banner/foto-diego.png',
    website: sponsorsMeta.fotoDiego.website,
  },
  {
    logo: '/images/sponsors-banner/terzini.png',
    website: sponsorsMeta.terzini.website,
  },
  { logo: '/images/sponsors-banner/goldengas.png' },
  {
    logo: '/images/sponsors-banner/sub-monte-conero.png',
    website: sponsorsMeta.subMonteConero.website,
  },
  { logo: '/images/sponsors-banner/ficarella-diving-club.png' },
  { logo: '/images/sponsors-banner/san-tommaso.png' },
  { logo: '/images/sponsors-banner/icp-logo.png' },
];
---

<div class="backdrop-blur-sm bg-white/70 py-6 overflow-hidden">
  <div class="marquee">
    {
      [false, true].map((duplicate) => (
        <ul
          class="flex items-center gap-8 pr-8"
          aria-hidden={duplicate ? "true" : undefined}
        >
          {sponsorsBanner.map((s) => {
            const img = (
              <img
                src={s.logo}
                alt="Sponsor logo"
                class:list={[
                  "h-12 md:h-16 w-auto object-contain",
                  s.website
                    ? "opacity-80 hover:opacity-100 transition-opacity"
                    : "opacity-80",
                ]}
              />
            );

            return (
              <li class="shrink-0">
                {s.website ? (
                  <a
                    href={s.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Sponsor"
                    class="block"
                  >
                    {img}
                  </a>
                ) : (
                  img
                )}
              </li>
            );
          })}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    display: flex;
    width: max-content;
    animation: sitS_marquee 20s linear infinite;
    will-change: transform;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
  }
  .marquee > ul {
    flex: none;
  }
  .marquee:hover {
    animation-play-state: paused;
  }
  @media (max-width: 640px) {
    .marquee {
      animation-duration: 10s;
    }
  }
  @keyframes sitS_marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      animation: none;
    }
  }
</style>
