{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "see-in-the-sea",
  "compatibility_date": "2025-04-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "r2_buckets": [
    {
      "binding": "R2_IMAGES_BUCKET",
      "bucket_name": "see-in-the-sea-images"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "see-in-the-sea-db",
      "database_id": "e385ed45-21fc-4f9b-90ad-93b6397789b1",
      "migrations_dir": "drizzle/migrations"
    }
  ]
}
